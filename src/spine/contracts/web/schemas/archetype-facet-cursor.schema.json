{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/archetype-facet-cursor.schema.json",
  "title": "Draft authenticated facet cursor payload v1",
  "type": "object",
  "required": [
    "contract_version",
    "command",
    "context_hash",
    "query_hash",
    "access_hash",
    "source_snapshot_hash",
    "issued_at_utc",
    "expires_at_utc",
    "authorization_valid_until_utc",
    "last_key"
  ],
  "properties": {
    "contract_version": {
      "const": "spine.facet-cursor.v1"
    },
    "command": {
      "enum": [
        "facet_schema.list",
        "item_archetype.facet_binding.list",
        "item.facets.query"
      ]
    },
    "context_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "query_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "access_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "source_snapshot_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "issued_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
    },
    "expires_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
    },
    "authorization_valid_until_utc": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_key": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "command": {
            "const": "item_archetype.facet_binding.list"
          }
        }
      },
      "then": {
        "properties": {
          "last_key": {
            "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
          }
        }
      }
    }
  ],
  "$comment": "Token authentication and temporal/equality checks are semantic; no runtime exposure."
}
