{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/recurrence-occurrence-response.schema.json",
  "title": "Spine Recurrence Occurrence Response v1",
  "type": "object",
  "required": [
    "ok",
    "command",
    "response_contract",
    "item_id",
    "item_type",
    "current_version",
    "source_item_version",
    "status",
    "title",
    "recurrence_set_id",
    "recurrence_revision_id",
    "revision_number",
    "normalized_recurrence_set_hash",
    "time_basis",
    "range_basis",
    "range_start",
    "range_end",
    "limit",
    "has_more",
    "next_cursor",
    "occurrences",
    "diagnostics"
  ],
  "properties": {
    "ok": { "const": true },
    "command": { "const": "item.occurrences" },
    "response_contract": { "const": "spine.item-occurrences.recurrence.v1" },
    "item_id": { "$ref": "recurrence-types.schema.json#/$defs/id" },
    "item_type": { "enum": ["event", "task"] },
    "current_version": { "$ref": "recurrence-types.schema.json#/$defs/decimalPositive" },
    "source_item_version": { "$ref": "recurrence-types.schema.json#/$defs/decimalPositive" },
    "status": { "enum": ["active", "archived"] },
    "archived_at_utc": { "$ref": "recurrence-types.schema.json#/$defs/utcTimestamp" },
    "title": { "type": "string", "minLength": 1 },
    "recurrence_set_id": { "$ref": "recurrence-types.schema.json#/$defs/id" },
    "recurrence_revision_id": { "$ref": "recurrence-types.schema.json#/$defs/id" },
    "revision_number": { "$ref": "recurrence-types.schema.json#/$defs/decimalPositive" },
    "normalized_recurrence_set_hash": { "$ref": "recurrence-types.schema.json#/$defs/sha256" },
    "time_basis": { "enum": ["local_date", "local_instant", "instant_utc"] },
    "timezone": { "type": "string", "minLength": 1 },
    "timezone_database_version": { "type": "string", "minLength": 1 },
    "range_basis": { "enum": ["original_schedule", "expressed_time"] },
    "range_start": { "$ref": "recurrence-types.schema.json#/$defs/scheduledFact" },
    "range_end": { "$ref": "recurrence-types.schema.json#/$defs/scheduledFact" },
    "limit": {
      "type": "string",
      "pattern": "^([1-9]|[1-9][0-9]|[1-9][0-9]{2}|1000)$"
    },
    "has_more": { "type": "boolean" },
    "next_cursor": { "type": ["string", "null"] },
    "occurrences": {
      "type": "array",
      "items": { "$ref": "#/$defs/occurrence" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "time_basis": { "const": "local_instant" } },
        "required": ["time_basis"]
      },
      "then": {
        "required": ["timezone", "timezone_database_version"],
        "properties": {
          "occurrences": {
            "items": { "required": ["timezone_resolution"] }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "time_basis": { "const": "local_date" } },
        "required": ["time_basis"]
      },
      "then": {
        "required": ["timezone", "timezone_database_version"],
        "properties": {
          "occurrences": {
            "items": {
              "required": ["timezone", "timezone_database_version"],
              "not": { "required": ["timezone_resolution"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "time_basis": { "const": "instant_utc" } },
        "required": ["time_basis"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["timezone"] },
            { "required": ["timezone_database_version"] }
          ]
        },
        "properties": {
          "occurrences": {
            "items": {
              "not": {
                "anyOf": [
                  { "required": ["timezone"] },
                  { "required": ["timezone_database_version"] },
                  { "required": ["timezone_resolution"] }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "archived" } },
        "required": ["status"]
      },
      "then": { "required": ["archived_at_utc"] },
      "else": { "not": { "required": ["archived_at_utc"] } }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "sourceEntry": {
      "oneOf": [
        {
          "type": "object",
          "required": ["source_kind", "source_id", "rule_local_index"],
          "properties": {
            "source_kind": { "const": "rule" },
            "source_id": { "$ref": "recurrence-types.schema.json#/$defs/id" },
            "rule_local_index": { "$ref": "recurrence-types.schema.json#/$defs/decimalNonNegative" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["source_kind", "source_id"],
          "properties": {
            "source_kind": { "const": "rdate" },
            "source_id": { "$ref": "recurrence-types.schema.json#/$defs/id" }
          },
          "additionalProperties": false
        }
      ]
    },
    "occurrenceTimezoneResolution": {
      "type": "object",
      "required": ["timezone", "timezone_database_version", "resolution_kind", "local_datetime", "utc_instant", "offset_seconds"],
      "properties": {
        "timezone": { "type": "string", "minLength": 1 },
        "timezone_database_version": { "type": "string", "minLength": 1 },
        "resolution_kind": { "enum": ["unambiguous", "ambiguous_earliest_instant"] },
        "local_datetime": { "$ref": "recurrence-types.schema.json#/$defs/localInstant" },
        "utc_instant": { "$ref": "recurrence-types.schema.json#/$defs/utcTimestamp" },
        "offset_seconds": { "type": "string", "pattern": "^(0|-?[1-9][0-9]*)$" }
      },
      "additionalProperties": false
    },
    "diagnosticTimezoneResolution": {
      "type": "object",
      "required": ["timezone", "timezone_database_version", "resolution_kind", "local_datetime"],
      "properties": {
        "timezone": { "type": "string", "minLength": 1 },
        "timezone_database_version": { "type": "string", "minLength": 1 },
        "resolution_kind": { "const": "nonexistent_omitted" },
        "local_datetime": { "$ref": "recurrence-types.schema.json#/$defs/localInstant" }
      },
      "additionalProperties": false
    },
    "valueAnchor": {
      "type": "object",
      "required": ["anchor_kind"],
      "properties": {
        "anchor_kind": { "enum": ["local_date", "local_instant", "instant_utc"] },
        "local_date": { "$ref": "recurrence-types.schema.json#/$defs/localDate" },
        "local_time": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$" },
        "timezone": { "type": "string", "minLength": 1 },
        "utc_instant": { "$ref": "recurrence-types.schema.json#/$defs/utcTimestamp" }
      },
      "additionalProperties": false
    },
    "eventDetail": {
      "type": "object",
      "required": ["event_status", "all_day", "start_anchor"],
      "properties": {
        "event_status": { "enum": ["scheduled", "cancelled"] },
        "all_day": { "type": "boolean" },
        "start_anchor": { "$ref": "#/$defs/valueAnchor" },
        "end_anchor": { "$ref": "#/$defs/valueAnchor" }
      },
      "additionalProperties": false
    },
    "taskDetail": {
      "type": "object",
      "required": ["task_status", "due_anchor"],
      "properties": {
        "task_status": { "enum": ["open", "done", "cancelled"] },
        "due_anchor": { "$ref": "#/$defs/valueAnchor" },
        "defer_until_anchor": { "$ref": "#/$defs/valueAnchor" },
        "priority": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "occurrence": {
      "type": "object",
      "required": [
        "occurrence_id",
        "occurrence_key",
        "recurrence_set_id",
        "recurrence_revision_id",
        "segment_id",
        "origin_kind",
        "normalized_recurrence_set_hash",
        "original_scheduled_fact",
        "expressed_scheduled_fact",
        "expressed_schedule_key",
        "range_basis",
        "lifecycle",
        "source_entries",
        "source_rule_ids",
        "source_rdate_ids",
        "virtual",
        "actionable"
      ],
      "properties": {
        "occurrence_id": { "$ref": "recurrence-types.schema.json#/$defs/id" },
        "occurrence_key": { "$ref": "recurrence-types.schema.json#/$defs/id" },
        "recurrence_set_id": { "$ref": "recurrence-types.schema.json#/$defs/id" },
        "recurrence_revision_id": { "$ref": "recurrence-types.schema.json#/$defs/id" },
        "segment_id": { "$ref": "recurrence-types.schema.json#/$defs/id" },
        "origin_kind": { "enum": ["rule", "rdate", "union"] },
        "normalized_recurrence_set_hash": { "$ref": "recurrence-types.schema.json#/$defs/sha256" },
        "original_scheduled_fact": { "$ref": "recurrence-types.schema.json#/$defs/scheduledFact" },
        "expressed_scheduled_fact": { "$ref": "recurrence-types.schema.json#/$defs/scheduledFact" },
        "expressed_schedule_key": { "$ref": "recurrence-types.schema.json#/$defs/id" },
        "range_basis": { "enum": ["original_schedule", "expressed_time"] },
        "lifecycle": { "enum": ["active", "cancelled", "completed"] },
        "source_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceEntry" }
        },
        "source_rule_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "recurrence-types.schema.json#/$defs/id" }
        },
        "source_rdate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "recurrence-types.schema.json#/$defs/id" }
        },
        "virtual": { "const": true },
        "actionable": { "type": "boolean" },
        "timezone": { "type": "string", "minLength": 1 },
        "timezone_database_version": { "type": "string", "minLength": 1 },
        "timezone_resolution": { "$ref": "#/$defs/occurrenceTimezoneResolution" },
        "override_id": { "$ref": "recurrence-types.schema.json#/$defs/id" },
        "occurrence_event_detail": { "$ref": "#/$defs/eventDetail" },
        "occurrence_task_detail": { "$ref": "#/$defs/taskDetail" }
      },
      "oneOf": [
        {
          "required": ["occurrence_event_detail"],
          "not": { "required": ["occurrence_task_detail"] }
        },
        {
          "required": ["occurrence_task_detail"],
          "not": { "required": ["occurrence_event_detail"] }
        }
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["severity", "diagnostic_code", "field"],
      "properties": {
        "severity": { "enum": ["info", "warning"] },
        "diagnostic_code": { "enum": ["dst_nonexistent_omitted", "pagination_observation"] },
        "field": { "type": "string", "minLength": 1 },
        "scheduled_fact": { "$ref": "recurrence-types.schema.json#/$defs/scheduledFact" },
        "timezone_resolution": { "$ref": "#/$defs/diagnosticTimezoneResolution" },
        "source_id": { "$ref": "recurrence-types.schema.json#/$defs/id" },
        "message": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        {
          "required": ["scheduled_fact", "timezone_resolution", "source_id"],
          "properties": {
            "severity": { "const": "warning" },
            "diagnostic_code": { "const": "dst_nonexistent_omitted" },
            "field": { "const": "timezone_resolution" }
          }
        },
        {
          "properties": {
            "severity": { "const": "info" },
            "diagnostic_code": { "const": "pagination_observation" },
            "field": { "const": "limit" }
          },
          "not": {
            "anyOf": [
              { "required": ["scheduled_fact"] },
              { "required": ["timezone_resolution"] },
              { "required": ["source_id"] }
            ]
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
