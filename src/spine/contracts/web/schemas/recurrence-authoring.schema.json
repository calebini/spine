{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/recurrence-authoring.schema.json",
  "title": "Spine Recurrence Authoring v1",
  "type": "object",
  "required": ["time_basis", "rules"],
  "properties": {
    "time_basis": { "enum": ["local_date", "local_instant", "instant_utc"] },
    "timezone": { "type": "string", "minLength": 1 },
    "timezone_database_version": { "type": "string", "minLength": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "recurrence-types.schema.json#/$defs/authoringRule" }
    },
    "rdates": {
      "type": "array",
      "items": { "$ref": "recurrence-types.schema.json#/$defs/authoringRdate" }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "recurrence-types.schema.json#/$defs/authoringSegment" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "time_basis": { "enum": ["local_date", "local_instant"] } },
        "required": ["time_basis"]
      },
      "then": { "required": ["timezone", "timezone_database_version"] }
    },
    {
      "if": {
        "properties": { "time_basis": { "const": "instant_utc" } },
        "required": ["time_basis"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["timezone"] },
            { "required": ["timezone_database_version"] }
          ]
        }
      }
    },
    {
      "if": { "required": ["segments"] },
      "then": {
        "properties": {
          "rules": { "items": { "required": ["segment_label"] } },
          "rdates": { "items": { "required": ["segment_label"] } }
        }
      },
      "else": {
        "properties": {
          "rules": { "items": { "not": { "required": ["segment_label"] } } },
          "rdates": { "items": { "not": { "required": ["segment_label"] } } }
        }
      }
    }
  ],
  "additionalProperties": false
}
