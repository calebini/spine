{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/notification-opportunity-response.schema.json",
  "title": "Spine Notification Opportunities Response v1",
  "type": "object",
  "required": [
    "ok", "command", "response_contract", "item_id", "item_type", "current_version", "evaluated_at_utc",
    "range_start_utc", "range_end_utc", "limit", "opportunities", "has_more", "next_cursor", "diagnostics"
  ],
  "properties": {
    "ok": { "const": true },
    "command": { "const": "notification.opportunities" },
    "response_contract": { "const": "spine.notification-opportunities.v1" },
    "item_id": { "$ref": "notification-types.schema.json#/$defs/id" },
    "item_type": { "enum": ["event", "task"] },
    "current_version": { "$ref": "notification-types.schema.json#/$defs/decimalPositive" },
    "evaluated_at_utc": { "$ref": "notification-types.schema.json#/$defs/utcTimestamp" },
    "range_start_utc": { "$ref": "notification-types.schema.json#/$defs/utcTimestamp" },
    "range_end_utc": { "$ref": "notification-types.schema.json#/$defs/utcTimestamp" },
    "limit": { "$ref": "notification-types.schema.json#/$defs/decimalPositive" },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "notification_opportunity_id", "notification_schedule_slot_key", "notification_intent_id",
          "notification_policy_id", "item_id", "source_item_version", "normalized_notification_schedule_hash",
          "anchor_role", "application_scope", "target_scheduled_fact", "eligible_at_utc",
          "recipient_kind", "channel", "delivery_target_id", "lifecycle", "actionable"
        ],
        "properties": {
          "notification_opportunity_id": { "$ref": "notification-types.schema.json#/$defs/id" },
          "notification_schedule_slot_key": { "$ref": "notification-types.schema.json#/$defs/id" },
          "notification_intent_id": { "$ref": "notification-types.schema.json#/$defs/id" },
          "notification_policy_id": { "$ref": "notification-types.schema.json#/$defs/id" },
          "item_id": { "$ref": "notification-types.schema.json#/$defs/id" },
          "source_item_version": { "$ref": "notification-types.schema.json#/$defs/decimalPositive" },
          "normalized_notification_schedule_hash": { "$ref": "notification-types.schema.json#/$defs/sha256" },
          "anchor_role": { "enum": ["event_start", "task_due"] },
          "application_scope": { "enum": ["item", "each_occurrence", "selected_occurrence"] },
          "target_scheduled_fact": { "type": "string", "minLength": 1 },
          "target_at_utc": { "$ref": "notification-types.schema.json#/$defs/utcTimestamp" },
          "eligible_at_utc": { "$ref": "notification-types.schema.json#/$defs/utcTimestamp" },
          "recipient_kind": { "enum": ["subject", "subject_group"] },
          "recipient_subject_id": { "$ref": "notification-types.schema.json#/$defs/id" },
          "recipient_group_id": { "$ref": "notification-types.schema.json#/$defs/id" },
          "channel": { "type": "string", "minLength": 1 },
          "delivery_target_id": { "$ref": "notification-types.schema.json#/$defs/id" },
          "occurrence_id": { "$ref": "notification-types.schema.json#/$defs/id" },
          "occurrence_key": { "$ref": "notification-types.schema.json#/$defs/id" },
          "occurrence_provenance_id": { "$ref": "notification-types.schema.json#/$defs/id" },
          "recurrence_set_id": { "$ref": "notification-types.schema.json#/$defs/id" },
          "recurrence_revision_id": { "$ref": "notification-types.schema.json#/$defs/id" },
          "lifecycle": { "enum": ["scheduled", "cancelled", "completed", "archived", "excluded"] },
          "actionable": { "type": "boolean" },
          "reason_code": {
            "enum": [
              "notification_policy_disabled",
              "item_inactive",
              "event_not_scheduled",
              "task_not_open",
              "occurrence_non_actionable",
              "delivery_target_unavailable",
              "notification_schedule_conflict"
            ]
          }
        },
        "allOf": [
          {
            "if": { "properties": { "recipient_kind": { "const": "subject" } }, "required": ["recipient_kind"] },
            "then": {
              "required": ["recipient_subject_id"],
              "not": { "required": ["recipient_group_id"] }
            },
            "else": {
              "required": ["recipient_group_id"],
              "not": { "required": ["recipient_subject_id"] }
            }
          },
          {
            "if": {
              "properties": { "application_scope": { "enum": ["each_occurrence", "selected_occurrence"] } },
              "required": ["application_scope"]
            },
            "then": {
              "required": [
                "occurrence_id", "occurrence_key", "occurrence_provenance_id",
                "recurrence_set_id", "recurrence_revision_id"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  { "required": ["occurrence_id"] },
                  { "required": ["occurrence_key"] },
                  { "required": ["occurrence_provenance_id"] },
                  { "required": ["recurrence_set_id"] },
                  { "required": ["recurrence_revision_id"] }
                ]
              }
            }
          },
          {
            "if": { "properties": { "actionable": { "const": false } }, "required": ["actionable"] },
            "then": { "required": ["reason_code"] },
            "else": { "not": { "required": ["reason_code"] } }
          }
        ],
        "additionalProperties": false
      }
    },
    "has_more": { "type": "boolean" },
    "next_cursor": { "type": ["string", "null"] },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["diagnostic_code", "field", "severity"],
        "properties": {
          "diagnostic_code": { "type": "string", "minLength": 1 },
          "field": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["info", "warning"] },
          "eligible_at_utc": { "$ref": "notification-types.schema.json#/$defs/utcTimestamp" },
          "source_id": { "$ref": "notification-types.schema.json#/$defs/id" },
          "message": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "has_more": { "const": true } }, "required": ["has_more"] },
      "then": { "properties": { "next_cursor": { "type": "string", "minLength": 1 } } },
      "else": { "properties": { "next_cursor": { "type": "null" } } }
    }
  ],
  "additionalProperties": false
}
