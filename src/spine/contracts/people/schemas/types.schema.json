{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/people/types.schema.json",
  "$comment": "Source-only people contract candidate; not advertised by or packaged with the current runtime.",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\ud800-\\udfff]+(?![\\s\\S])"
    },
    "version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(?![\\s\\S])"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
    },
    "owner": {
      "$ref": "https://cortext.local/spine/contracts/schemas/trusted-web-types.schema.json#/$defs/owner"
    },
    "cursorToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "limit": {
      "type": "string",
      "pattern": "^([1-9]|[1-9][0-9]|100)(?![\\s\\S])"
    },
    "patch": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "participants": {
              "type": "array",
              "items": {
                "$ref": "https://cortext.local/spine/contracts/schemas/people/types.schema.json#/$defs/id"
              },
              "maxItems": 100,
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [
            "participants"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "assignees": {
              "type": "array",
              "items": {
                "$ref": "https://cortext.local/spine/contracts/schemas/people/types.schema.json#/$defs/id"
              },
              "maxItems": 100,
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [
            "assignees"
          ],
          "additionalProperties": false
        }
      ]
    },
    "association": {
      "type": "object",
      "properties": {
        "item_subject_role_id": {
          "$ref": "https://cortext.local/spine/contracts/schemas/people/types.schema.json#/$defs/id"
        },
        "subject_id": {
          "$ref": "https://cortext.local/spine/contracts/schemas/people/types.schema.json#/$defs/id"
        },
        "role": {
          "enum": [
            "participant",
            "assignee"
          ]
        },
        "status": {
          "enum": [
            "active",
            "inactive"
          ]
        }
      },
      "required": [
        "item_subject_role_id",
        "subject_id",
        "role",
        "status"
      ],
      "additionalProperties": false
    },
    "label": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "availability": {
              "const": "available"
            },
            "display_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "subject_kind": {
              "enum": [
                "person",
                "agent"
              ]
            },
            "status": {
              "enum": [
                "active",
                "inactive"
              ]
            }
          },
          "required": [
            "availability",
            "display_name",
            "subject_kind",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "availability": {
              "const": "not_disclosed"
            }
          },
          "required": [
            "availability"
          ],
          "additionalProperties": false
        }
      ]
    },
    "projection": {
      "type": "object",
      "properties": {
        "item_id": {
          "$ref": "https://cortext.local/spine/contracts/schemas/people/types.schema.json#/$defs/id"
        },
        "item_type": {
          "enum": [
            "event",
            "task"
          ]
        },
        "item_version": {
          "$ref": "https://cortext.local/spine/contracts/schemas/people/types.schema.json#/$defs/version"
        },
        "associations": {
          "type": "array",
          "items": {
            "$ref": "https://cortext.local/spine/contracts/schemas/people/types.schema.json#/$defs/association"
          },
          "maxItems": 100,
          "minItems": 0
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject_id": {
                "$ref": "https://cortext.local/spine/contracts/schemas/people/types.schema.json#/$defs/id"
              },
              "label": {
                "$ref": "https://cortext.local/spine/contracts/schemas/people/types.schema.json#/$defs/label"
              }
            },
            "required": [
              "subject_id",
              "label"
            ],
            "additionalProperties": false
          },
          "maxItems": 100,
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "item_id",
        "item_type",
        "item_version",
        "associations",
        "subjects"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "item_type": {
                "const": "event"
              }
            }
          },
          "then": {
            "properties": {
              "associations": {
                "items": {
                  "properties": {
                    "role": {
                      "const": "participant"
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "associations": {
                "items": {
                  "properties": {
                    "role": {
                      "const": "assignee"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "section": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "availability": {
              "const": "not_requested"
            },
            "scope": {
              "const": "authorized_only"
            }
          },
          "required": [
            "availability",
            "scope"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "availability": {
              "const": "unavailable"
            },
            "scope": {
              "const": "authorized_only"
            },
            "coverage": {
              "const": "incomplete"
            },
            "reason_code": {
              "const": "context_unavailable"
            }
          },
          "required": [
            "availability",
            "scope",
            "coverage",
            "reason_code"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "availability": {
              "const": "available"
            },
            "scope": {
              "const": "authorized_only"
            },
            "coverage": {
              "const": "complete"
            },
            "people": {
              "$ref": "https://cortext.local/spine/contracts/schemas/people/types.schema.json#/$defs/projection"
            }
          },
          "required": [
            "availability",
            "scope",
            "coverage",
            "people"
          ],
          "additionalProperties": false
        }
      ]
    },
    "personFilter": {
      "type": "object",
      "properties": {
        "subject_id": {
          "$ref": "https://cortext.local/spine/contracts/schemas/people/types.schema.json#/$defs/id"
        },
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "participant",
              "assignee"
            ]
          },
          "maxItems": 2,
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "subject_id"
      ],
      "additionalProperties": false
    }
  }
}
