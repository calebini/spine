{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/schedule-create-response.schema.json",
  "title": "Spine Atomic Schedule Create Response v2",
  "oneOf": [
    {
      "$ref": "#/$defs/success"
    },
    {
      "$ref": "#/$defs/failure"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "decimalNonNegative": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "utcTimestamp": {
      "$ref": "notification-types.schema.json#/$defs/utcTimestamp"
    },
    "resolvedSchedule": {
      "type": "object",
      "required": [
        "anchor_id",
        "time_basis",
        "local_date",
        "local_time",
        "timezone",
        "timezone_database_version",
        "resolution_kind",
        "utc_instant",
        "offset_seconds"
      ],
      "properties": {
        "anchor_id": {
          "$ref": "#/$defs/id"
        },
        "time_basis": {
          "const": "local_instant"
        },
        "local_date": {
          "type": "string"
        },
        "local_time": {
          "type": "string"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "timezone_database_version": {
          "type": "string",
          "minLength": 1
        },
        "resolution_kind": {
          "const": "unambiguous"
        },
        "utc_instant": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "offset_seconds": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)$"
        }
      },
      "additionalProperties": false
    },
    "recurrence": {
      "type": "object",
      "required": [
        "recurrence_set_id",
        "recurrence_revision_id",
        "revision_number",
        "normalized_recurrence_set_hash",
        "diagnostics"
      ],
      "properties": {
        "recurrence_set_id": {
          "$ref": "#/$defs/id"
        },
        "recurrence_revision_id": {
          "$ref": "#/$defs/id"
        },
        "revision_number": {
          "const": "1"
        },
        "normalized_recurrence_set_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "required": [
        "delivery_target_id",
        "resolution_source",
        "recipient_kind",
        "channel",
        "adapter_name",
        "target_ref",
        "delivery_state"
      ],
      "properties": {
        "delivery_target_id": {
          "$ref": "#/$defs/id"
        },
        "resolution_source": {
          "enum": [
            "explicit",
            "context_default"
          ]
        },
        "default_key": {
          "type": "string",
          "minLength": 1
        },
        "recipient_kind": {
          "enum": [
            "subject",
            "subject_group"
          ]
        },
        "recipient_subject_id": {
          "$ref": "#/$defs/id"
        },
        "recipient_group_id": {
          "$ref": "#/$defs/id"
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "adapter_name": {
          "type": "string",
          "minLength": 1
        },
        "target_ref": {
          "type": "string",
          "minLength": 1
        },
        "delivery_state": {
          "const": "not_attempted_by_command"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resolution_source": {
                "const": "context_default"
              }
            },
            "required": [
              "resolution_source"
            ]
          },
          "then": {
            "required": [
              "default_key"
            ]
          },
          "else": {
            "not": {
              "required": [
                "default_key"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "recipient_kind": {
                "const": "subject"
              }
            },
            "required": [
              "recipient_kind"
            ]
          },
          "then": {
            "required": [
              "recipient_subject_id"
            ],
            "not": {
              "required": [
                "recipient_group_id"
              ]
            }
          },
          "else": {
            "required": [
              "recipient_group_id"
            ],
            "not": {
              "required": [
                "recipient_subject_id"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "policy_key",
        "notification_intent_id",
        "notification_policy_id",
        "notification_schedule_id",
        "normalized_notification_schedule_hash",
        "status"
      ],
      "properties": {
        "policy_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "notification_intent_id": {
          "$ref": "#/$defs/id"
        },
        "notification_policy_id": {
          "$ref": "#/$defs/id"
        },
        "notification_schedule_id": {
          "$ref": "#/$defs/id"
        },
        "normalized_notification_schedule_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "const": "active"
        }
      },
      "additionalProperties": false
    },
    "opportunityWork": {
      "type": "object",
      "required": [
        "policy_key",
        "notification_intent_id",
        "notification_policy_id",
        "notification_opportunity_id",
        "eligible_at_utc",
        "work_instance_id"
      ],
      "properties": {
        "policy_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "notification_intent_id": {
          "$ref": "#/$defs/id"
        },
        "notification_policy_id": {
          "$ref": "#/$defs/id"
        },
        "notification_opportunity_id": {
          "$ref": "#/$defs/id"
        },
        "eligible_at_utc": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "occurrence_key": {
          "$ref": "#/$defs/id"
        },
        "original_scheduled_fact": {
          "type": "string",
          "minLength": 1
        },
        "expressed_scheduled_fact": {
          "type": "string",
          "minLength": 1
        },
        "work_instance_id": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": false
    },
    "materializationNone": {
      "type": "object",
      "required": [
        "mode",
        "state",
        "opportunity_count",
        "work_instance_count",
        "opportunity_work",
        "work_instance_ids"
      ],
      "properties": {
        "mode": {
          "const": "none"
        },
        "state": {
          "const": "not_requested"
        },
        "opportunity_count": {
          "const": "0"
        },
        "work_instance_count": {
          "const": "0"
        },
        "opportunity_work": {
          "type": "array",
          "maxItems": 0
        },
        "work_instance_ids": {
          "type": "array",
          "maxItems": 0
        }
      },
      "additionalProperties": false
    },
    "materializationBounded": {
      "type": "object",
      "required": [
        "mode",
        "state",
        "evaluated_at_utc",
        "range_start_utc",
        "range_end_utc",
        "limit",
        "opportunity_count",
        "work_instance_count",
        "opportunity_work",
        "work_instance_ids"
      ],
      "properties": {
        "mode": {
          "const": "bounded"
        },
        "state": {
          "enum": [
            "materialized",
            "completed_zero_selected"
          ]
        },
        "evaluated_at_utc": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "range_start_utc": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "range_end_utc": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "limit": {
          "type": "string",
          "pattern": "^([1-9]|[1-9][0-9]|[1-9][0-9]{2}|1000)$"
        },
        "opportunity_count": {
          "$ref": "#/$defs/decimalNonNegative"
        },
        "work_instance_count": {
          "$ref": "#/$defs/decimalNonNegative"
        },
        "opportunity_work": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/opportunityWork"
          }
        },
        "work_instance_ids": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "additionalProperties": false
    },
    "phases": {
      "type": "object",
      "required": [
        "item",
        "policies",
        "provenance",
        "opportunities",
        "work",
        "delivery"
      ],
      "properties": {
        "item": {
          "const": "created"
        },
        "policies": {
          "const": "authored"
        },
        "provenance": {
          "enum": [
            "regenerated",
            "not_applicable",
            "not_requested"
          ]
        },
        "opportunities": {
          "enum": [
            "expanded",
            "not_requested"
          ]
        },
        "work": {
          "enum": [
            "materialized",
            "completed_zero_selected",
            "not_requested"
          ]
        },
        "delivery": {
          "const": "not_attempted"
        }
      },
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "required": [
        "receipt_contract",
        "command_receipt_id",
        "effect",
        "semantic_facts_hash",
        "created_at_utc"
      ],
      "properties": {
        "receipt_contract": {
          "const": "spine.schedule-create-receipt.v2"
        },
        "command_receipt_id": {
          "$ref": "#/$defs/id"
        },
        "effect": {
          "const": "schedule_created",
          "description": "The command-receipt effect: persisted as schedule_created for fresh success and replay, and returned as that would-be value for dry run."
        },
        "semantic_facts_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "created_at_utc": {
          "$ref": "#/$defs/utcTimestamp"
        }
      },
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "required": [
        "ok",
        "command",
        "response_contract",
        "effect",
        "command_id",
        "command_receipt_id",
        "audit_id",
        "created_at_utc",
        "item_id",
        "item_type",
        "current_version",
        "title",
        "scheduled_time",
        "delivery",
        "policies",
        "materialization",
        "phases",
        "receipt",
        "archetype",
        "notification_profile"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "command": {
          "const": "schedule.create"
        },
        "response_contract": {
          "const": "spine.schedule-create-response.v2"
        },
        "effect": {
          "enum": [
            "schedule_created",
            "schedule_create_replay"
          ],
          "description": "The response branch effect: schedule_created for fresh or dry-run success and schedule_create_replay for compatible replay."
        },
        "dry_run": {
          "const": true
        },
        "command_id": {
          "$ref": "#/$defs/id"
        },
        "command_receipt_id": {
          "$ref": "#/$defs/id"
        },
        "audit_id": {
          "$ref": "#/$defs/id"
        },
        "created_at_utc": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "item_id": {
          "$ref": "#/$defs/id"
        },
        "item_type": {
          "enum": [
            "event",
            "task"
          ]
        },
        "current_version": {
          "const": "1"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scheduled_time": {
          "$ref": "#/$defs/resolvedSchedule"
        },
        "primary_location": {
          "$ref": "schedule-primary-location-types.schema.json#/$defs/view"
        },
        "recurrence": {
          "$ref": "#/$defs/recurrence"
        },
        "delivery": {
          "$ref": "#/$defs/delivery"
        },
        "policies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/policy"
          }
        },
        "materialization": {
          "oneOf": [
            {
              "$ref": "#/$defs/materializationNone"
            },
            {
              "$ref": "#/$defs/materializationBounded"
            }
          ]
        },
        "phases": {
          "$ref": "#/$defs/phases"
        },
        "receipt": {
          "$ref": "#/$defs/receipt"
        },
        "archetype": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "notification_profile": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "materialization": {
                "properties": {
                  "mode": {
                    "const": "none"
                  }
                },
                "required": [
                  "mode"
                ]
              }
            },
            "required": [
              "materialization"
            ]
          },
          "then": {
            "properties": {
              "phases": {
                "properties": {
                  "opportunities": {
                    "const": "not_requested"
                  },
                  "work": {
                    "const": "not_requested"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "phases": {
                "properties": {
                  "opportunities": {
                    "const": "expanded"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "recurrence"
            ]
          },
          "then": {
            "if": {
              "properties": {
                "materialization": {
                  "properties": {
                    "mode": {
                      "const": "bounded"
                    }
                  },
                  "required": [
                    "mode"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "phases": {
                  "properties": {
                    "provenance": {
                      "const": "regenerated"
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "phases": {
                  "properties": {
                    "provenance": {
                      "const": "not_requested"
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "phases": {
                "properties": {
                  "provenance": {
                    "const": "not_applicable"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "materialization": {
                "properties": {
                  "state": {
                    "const": "materialized"
                  }
                },
                "required": [
                  "state"
                ]
              }
            },
            "required": [
              "materialization"
            ]
          },
          "then": {
            "properties": {
              "phases": {
                "properties": {
                  "work": {
                    "const": "materialized"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "materialization": {
                "properties": {
                  "state": {
                    "const": "completed_zero_selected"
                  }
                },
                "required": [
                  "state"
                ]
              }
            },
            "required": [
              "materialization"
            ]
          },
          "then": {
            "properties": {
              "phases": {
                "properties": {
                  "work": {
                    "const": "completed_zero_selected"
                  }
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": [
        "ok",
        "command",
        "error"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "command": {
          "const": "schedule.create"
        },
        "dry_run": {
          "const": true
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "enum": [
                "invalid_request",
                "unsupported_field",
                "missing_required_field",
                "invalid_timestamp",
                "referenced_row_not_found",
                "semantic_conflict",
                "environment_failure",
                "runtime_failure"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "field": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
