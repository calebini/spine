{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/people/cursor-config.schema.json",
  "$comment": "Source-only people contract candidate; not advertised by or packaged with the current runtime.",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "spine.people-cursor-config.v1"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
    },
    "key_generation": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
    },
    "ledger_instance_id": {
      "$ref": "https://cortext.local/spine/contracts/schemas/people/types.schema.json#/$defs/id"
    },
    "secret_hex": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2}){32,64}(?![\\s\\S])"
    }
  },
  "required": [
    "contract_version",
    "key_id",
    "key_generation",
    "ledger_instance_id",
    "secret_hex"
  ],
  "additionalProperties": false
}
