            "owner_group_id": {
              "$ref": "https://cortext.local/spine/contracts/schemas/recurring-related-tasks/types.schema.json#/$defs/id"
            }
          },
          "required": [
            "owner_kind",
            "owner_group_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "delivery": {
      "const": "not_attempted_by_command"
    },
    "ruleId": {
      "type": "string",
      "pattern": "^(?:related_task_rule_[0-9a-f]{64})(?![\\s\\S])"
    },
    "revisionId": {
      "type": "string",
      "pattern": "^(?:related_task_rule_revision_[0-9a-f]{64})(?![\\s\\S])"
    },
    "assignmentId": {
      "type": "string",
      "pattern": "^(?:related_task_assignment_[0-9a-f]{64})(?![\\s\\S])"
    },
    "generationId": {
      "type": "string",
      "pattern": "^(?:related_task_generation_[0-9a-f]{64})(?![\\s\\S])"
    },
    "proofId": {
      "type": "string",
      "pattern": "^(?:related_task_proof_[0-9a-f]{64})(?![\\s\\S])"
    },
    "assignmentRevisionId": {
      "type": "string",
      "pattern": "^(?:related_task_assignment_revision_[0-9a-f]{64})(?![\\s\\S])"
    },
    "intentId": {
      "type": "string",
      "pattern": "^(?:related_task_intent_[0-9a-f]{64})(?![\\s\\S])"
    },
    "suppressionId": {
      "type": "string",
      "pattern": "^(?:related_task_suppression_[0-9a-f]{64})(?![\\s\\S])"
    },
    "offset": {
      "type": "string",
      "pattern": "^(?:0|-?(?:[1-9][0-9]{0,6}|[1-2][0-9]{7}|30[0-9]{6}|31[0-5][0-9]{5}|316[0-1][0-9]{4}|3162[0-1][0-9]{3}|31622[0-3][0-9]{2}|31622400))(?![\\s\\S])"
    },
    "horizon": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,6}|[1-2][0-9]{7}|30[0-9]{6}|31[0-5][0-9]{5}|316[0-1][0-9]{4}|3162[0-1][0-9]{3}|31622[0-3][0-9]{2}|31622400)(?![\\s\\S])"
    },
    "lookback": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,6}|[1-2][0-9]{7}|30[0-9]{6}|31[0-5][0-9]{5}|316[0-1][0-9]{4}|3162[0-1][0-9]{3}|31622[0-3][0-9]{2}|31622400)(?![\\s\\S])"
    },
    "cursor": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{43})(?![\\s\\S])"
    },
    "limits": {
      "type": "object",
      "properties": {
        "source_candidates": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,2}|1[0-9]{3}|20[0-3][0-9]{1}|204[0-7]|2048)(?![\\s\\S])",
          "default": "256"
        },
        "assignments": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,1}|1[0-1][0-9]{1}|12[0-7]|128)(?![\\s\\S])",
          "default": "32"
        },
        "mutations": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,1}|1[0-1][0-9]{1}|12[0-7]|128)(?![\\s\\S])",
          "default": "32"
        },
        "proof_steps": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,3}|[1-4][0-9]{4}|50000)(?![\\s\\S])",
          "default": "10000"
        },
        "lineage_hops": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,1}|1[0-9]{2}|2[0-4][0-9]{1}|25[0-5]|256)(?![\\s\\S])",
          "default": "64"
        },
        "work_rows": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,2}|[1-3][0-9]{3}|40[0-8][0-9]{1}|409[0-5]|4096)(?![\\s\\S])",
          "default": "128"
        },
        "response_bytes": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,5}|10[0-3][0-9]{4}|104[0-7][0-9]{3}|1048[0-4][0-9]{2}|10485[0-6][0-9]{1}|104857[0-5]|1048576)(?![\\s\\S])",
          "default": "262144"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "normalizedLimits": {
      "type": "object",
      "properties": {
        "source_candidates": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,2}|1[0-9]{3}|20[0-3][0-9]{1}|204[0-7]|2048)(?![\\s\\S])",
          "default": "256"
        },
        "assignments": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,1}|1[0-1][0-9]{1}|12[0-7]|128)(?![\\s\\S])",
          "default": "32"
        },
        "mutations": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,1}|1[0-1][0-9]{1}|12[0-7]|128)(?![\\s\\S])",
          "default": "32"
        },
        "proof_steps": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,3}|[1-4][0-9]{4}|50000)(?![\\s\\S])",
          "default": "10000"
        },
        "lineage_hops": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,1}|1[0-9]{2}|2[0-4][0-9]{1}|25[0-5]|256)(?![\\s\\S])",
          "default": "64"
        },
        "work_rows": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,2}|[1-3][0-9]{3}|40[0-8][0-9]{1}|409[0-5]|4096)(?![\\s\\S])",
          "default": "128"
        },
        "response_bytes": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,5}|10[0-3][0-9]{4}|104[0-7][0-9]{3}|1048[0-4][0-9]{2}|10485[0-6][0-9]{1}|104857[0-5]|1048576)(?![\\s\\S])",
          "default": "262144"
        }
      },
      "required": [
        "source_candidates",
        "assignments",
        "mutations",
        "proof_steps",
        "lineage_hops",
        "work_rows",
        "response_bytes"
      ],
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "properties": {
        "rule_change_version": {
          "$ref": "https://cortext.local/spine/contracts/schemas/recurring-related-tasks/types.schema.json#/$defs/positive"
