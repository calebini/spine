{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/recurring-related-tasks/types.schema.json",
  "title": "Recurring related tasks v1 shared types (ratified, source only)",
  "$comment": "No runtime or HTTP activation. Cross-field ordering, reference equality, byte limits and semantic validation are specified separately; JSON Schema iteration is not command error precedence.",
  "$defs": {
    "id": {
      "$ref": "../notification-types.schema.json#/$defs/id"
    },
    "key": {
      "type": "string",
      "pattern": "^(?:[a-z][a-z0-9_-]{0,63})(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)(?![\\s\\S])"
    },
    "positive": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)(?![\\s\\S])"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z(?![\\s\\S])"
    },
    "fact": {
      "$ref": "../recurrence-types.schema.json#/$defs/scheduledFact"
    },
    "owner": {
      "$ref": "../notification-profile-types-v2.schema.json#/$defs/owner"
    },
    "itemOwner": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "owner_kind": {
              "const": "subject"
            },
            "owner_subject_id": {
              "$ref": "https://cortext.local/spine/contracts/schemas/recurring-related-tasks/types.schema.json#/$defs/id"
            }
          },
          "required": [
            "owner_kind",
            "owner_subject_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "owner_kind": {
              "const": "subject_group"
