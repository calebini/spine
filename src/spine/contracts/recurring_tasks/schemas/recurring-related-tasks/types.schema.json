        "derivation_version",
        "contract_version",
        "normalization_version",
        "canonical_json_version",
        "recurrence_set_id",
        "segment_ref",
        "scheduled_fact",
        "origin_kind",
        "source_rule_selectors",
        "source_rdate_selectors"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "origin_kind": {
                "const": "rule"
              }
            }
          },
          "then": {
            "properties": {
              "source_rule_selectors": {
                "minItems": 1,
                "maxItems": 1
              },
              "source_rdate_selectors": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "origin_kind": {
                "const": "rdate"
              }
            }
          },
          "then": {
            "properties": {
              "source_rule_selectors": {
                "maxItems": 0
              },
              "source_rdate_selectors": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "origin_kind": {
                "const": "union"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "source_rule_selectors": {
                    "minItems": 2
                  }
                }
              },
              {
                "properties": {
                  "source_rule_selectors": {
                    "minItems": 1
                  },
                  "source_rdate_selectors": {
                    "minItems": 1
                  }
                }
              }
            ]
          }
        }
      ]
