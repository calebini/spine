{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/local-ownership-bootstrap/provisioning-apply-response.v3.schema.json",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "spine.trusted-web-provisioning.v3"
    },
    "ok": {
      "$ref": "../trusted-web-provisioning-apply-response.v2.schema.json#/properties/ok"
    },
    "command": {
      "$ref": "../trusted-web-provisioning-apply-response.v2.schema.json#/properties/command"
    },
    "command_id": {
      "$ref": "../trusted-web-provisioning-apply-response.v2.schema.json#/properties/command_id"
    },
    "command_receipt_id": {
      "$ref": "../trusted-web-provisioning-apply-response.v2.schema.json#/properties/command_receipt_id"
    },
    "audit_id": {
      "$ref": "../trusted-web-provisioning-apply-response.v2.schema.json#/properties/audit_id"
    },
    "effect": {
      "$ref": "../trusted-web-provisioning-apply-response.v2.schema.json#/properties/effect"
    },
    "changed": {
      "$ref": "../trusted-web-provisioning-apply-response.v2.schema.json#/properties/changed"
    },
    "replayed": {
      "$ref": "../trusted-web-provisioning-apply-response.v2.schema.json#/properties/replayed"
    },
    "access_epoch": {
      "$ref": "types.schema.json#/$defs/positive"
    },
    "plan_hash": {
      "$ref": "../trusted-web-provisioning-apply-response.v2.schema.json#/properties/plan_hash"
    },
    "results": {
      "$ref": "../trusted-web-provisioning-apply-response.v2.schema.json#/properties/results"
    }
  },
  "required": [
    "contract_version",
    "ok",
    "command",
    "command_id",
    "command_receipt_id",
    "audit_id",
    "effect",
    "changed",
    "replayed",
    "access_epoch",
    "plan_hash",
    "results"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "effect": {
            "const": "web_access_noop"
          }
        }
      },
      "then": {
        "properties": {
          "changed": {
            "const": false
          }
        }
      },
      "else": {
        "properties": {
          "changed": {
            "const": true
          }
        }
      }
    }
  ]
}
