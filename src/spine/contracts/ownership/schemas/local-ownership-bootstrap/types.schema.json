{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/local-ownership-bootstrap/types.schema.json",
  "$defs": {
    "id": {
      "allOf": [
        {
          "$ref": "../trusted-web-types.schema.json#/$defs/id"
        },
        {
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        }
      ]
    },
    "positive": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)(?![\\s\\S])"
    },
    "decimal": {
      "oneOf": [
        {
          "const": "0"
        },
        {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)(?![\\s\\S])"
        }
      ]
    },
    "instanceId": {
      "type": "string",
      "pattern": "^ledger_instance_[0-9a-f]{64}(?![\\s\\S])"
    },
    "stateRow": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "singleton_id": {
              "const": "1"
            },
            "ledger_id": {
              "$ref": "#/$defs/instanceId"
            },
            "realm_id": {
              "type": "null"
            },
            "mode": {
              "const": "trusted_local"
            },
            "identity_mode": {
              "type": "null"
            },
            "access_epoch": {
              "$ref": "#/$defs/positive"
            },
            "recovery_epoch": {
              "$ref": "#/$defs/positive"
            }
          },
          "required": [
            "singleton_id",
            "ledger_id",
            "realm_id",
            "mode",
            "identity_mode",
            "access_epoch",
            "recovery_epoch"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "singleton_id": {
              "const": "1"
            },
            "ledger_id": {
              "$ref": "#/$defs/id"
            },
            "realm_id": {
              "$ref": "#/$defs/id"
            },
            "mode": {
              "const": "multi_user"
            },
            "identity_mode": {
              "const": "trusted_identity"
            },
            "access_epoch": {
              "$ref": "#/$defs/positive"
            },
            "recovery_epoch": {
              "$ref": "#/$defs/positive"
            }
          },
          "required": [
            "singleton_id",
            "ledger_id",
            "realm_id",
            "mode",
            "identity_mode",
            "access_epoch",
            "recovery_epoch"
          ],
          "additionalProperties": false
        }
      ]
    },
    "state": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/stateRow"
        }
      ]
    }
  }
}
