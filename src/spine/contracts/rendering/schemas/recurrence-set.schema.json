{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/recurrence-set.schema.json",
  "title": "Spine Normalized Recurrence Set v1",
  "type": "object",
  "required": [
    "recurrence_set_id",
    "recurrence_revision_id",
    "revision_number",
    "source_item_id",
    "created_item_version",
    "source_item_version",
    "seed_anchor_id",
    "time_basis",
    "rules",
    "rdates",
    "exdates",
    "overrides",
    "segments",
    "normalized_recurrence_set_hash"
  ],
  "properties": {
    "contract_version": { "const": "spine.recurrence.contract.v1" },
    "normalization_version": { "const": "spine.recurrence.normalization.v1" },
    "canonical_json_version": { "const": "spine.canonical-json.v1" },
    "recurrence_set_id": { "$ref": "recurrence-types.schema.json#/$defs/id" },
    "recurrence_revision_id": { "$ref": "recurrence-types.schema.json#/$defs/id" },
    "revision_number": { "$ref": "recurrence-types.schema.json#/$defs/decimalPositive" },
    "source_item_id": { "$ref": "recurrence-types.schema.json#/$defs/id" },
    "created_item_version": { "$ref": "recurrence-types.schema.json#/$defs/decimalPositive" },
    "source_item_version": { "$ref": "recurrence-types.schema.json#/$defs/decimalPositive" },
    "seed_anchor_id": { "$ref": "recurrence-types.schema.json#/$defs/id" },
    "time_basis": { "enum": ["local_date", "local_instant", "instant_utc"] },
    "timezone": { "type": "string", "minLength": 1 },
    "timezone_database_version": { "type": "string", "minLength": 1 },
    "normalized_recurrence_set_hash": { "$ref": "recurrence-types.schema.json#/$defs/sha256" },
    "rules": {
      "type": "array",
      "items": { "$ref": "recurrence-types.schema.json#/$defs/normalizedRule" }
    },
    "rdates": {
      "type": "array",
      "items": { "$ref": "recurrence-types.schema.json#/$defs/normalizedRdate" }
    },
    "exdates": {
      "type": "array",
      "items": { "$ref": "recurrence-types.schema.json#/$defs/normalizedExdate" }
    },
    "overrides": {
      "type": "array",
      "items": { "$ref": "recurrence-types.schema.json#/$defs/normalizedOverride" }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "recurrence-types.schema.json#/$defs/normalizedSegment" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "time_basis": { "enum": ["local_date", "local_instant"] } },
        "required": ["time_basis"]
      },
      "then": { "required": ["timezone", "timezone_database_version"] }
    },
    {
      "if": {
        "properties": { "time_basis": { "const": "instant_utc" } },
        "required": ["time_basis"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["timezone"] },
            { "required": ["timezone_database_version"] }
          ]
        }
      }
    }
  ],
  "additionalProperties": false
}
