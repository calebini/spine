{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/notification-profile-application-v2.schema.json",
  "title": "Spine notification-profile-application-v2 (specified, not implemented)",
  "type": "object",
  "required": [
    "application_contract",
    "notification_profile_application_id",
    "notification_profile_id",
    "notification_profile_revision_id",
    "selection_mode",
    "notification_profile_binding_id",
    "scope_chain",
    "normalized_profile_revision_hash",
    "suppress_template_keys",
    "replacements",
    "custom_additions",
    "normalized_effective_policy_set_hash",
    "effective_presentation_set_hash",
    "policies"
  ],
  "properties": {
    "application_contract": {
      "const": "spine.notification-profile-application.v2"
    },
    "notification_profile_application_id": {
      "$ref": "notification-types.schema.json#/$defs/id"
    },
    "notification_profile_id": {
      "$ref": "notification-types.schema.json#/$defs/id"
    },
    "notification_profile_revision_id": {
      "$ref": "notification-types.schema.json#/$defs/id"
    },
    "selection_mode": {
      "enum": [
        "explicit",
        "archetype_default"
      ]
    },
    "notification_profile_binding_id": {
      "oneOf": [
        {
          "$ref": "notification-types.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope_chain": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "notification-profile-types-v2.schema.json#/$defs/owner" }
    },
    "normalized_profile_revision_hash": {
      "$ref": "notification-types.schema.json#/$defs/sha256"
    },
    "suppress_template_keys": {
      "$ref": "notification-profile-types-v2.schema.json#/$defs/overlays/properties/suppress_template_keys"
    },
    "replacements": {
      "$ref": "notification-profile-types-v2.schema.json#/$defs/overlays/properties/replacements"
    },
    "custom_additions": {
      "$ref": "notification-profile-types-v2.schema.json#/$defs/overlays/properties/custom_additions"
    },
    "normalized_effective_policy_set_hash": {
      "$ref": "notification-types.schema.json#/$defs/sha256"
    },
    "effective_presentation_set_hash": {
      "$ref": "notification-types.schema.json#/$defs/sha256"
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "policy_origin",
          "source_key",
          "notification_intent_id",
          "notification_policy_id",
          "presentation",
          "presentation_hash"
        ],
        "properties": {
          "policy_origin": {
            "enum": [
              "profile_template",
              "profile_replacement",
              "custom_addition"
            ]
          },
          "source_key": {
            "$ref": "notification-profile-types.schema.json#/$defs/key"
          },
          "notification_intent_id": {
            "$ref": "notification-types.schema.json#/$defs/id"
          },
          "notification_policy_id": {
            "$ref": "notification-types.schema.json#/$defs/id"
          },
          "presentation": {
            "$ref": "notification-rendering-definition-types.schema.json#/$defs/policyPresentation"
          },
          "presentation_hash": {
            "$ref": "notification-types.schema.json#/$defs/sha256"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "selection_mode": { "const": "archetype_default" } } },
      "then": {
        "properties": {
          "scope_chain": { "minItems": 1 },
          "notification_profile_binding_id": { "type": "string" }
        }
      },
      "else": {
        "properties": {
          "scope_chain": { "maxItems": 0 },
          "notification_profile_binding_id": { "type": "null" }
        }
      }
    }
  ],
  "additionalProperties": false
}
