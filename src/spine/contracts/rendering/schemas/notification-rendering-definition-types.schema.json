{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/notification-rendering-definition-types.schema.json",
  "title": "Spine rendering-definition types v1 — specified, not implemented",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decimalPositive": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "owner": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "owner_kind"
          ],
          "properties": {
            "owner_kind": {
              "const": "system"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "owner_kind",
            "owner_subject_id"
          ],
          "properties": {
            "owner_kind": {
              "const": "subject"
            },
            "owner_subject_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "owner_kind",
            "owner_group_id"
          ],
          "properties": {
            "owner_kind": {
              "const": "subject_group"
            },
            "owner_group_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "definitionReference": {
      "type": "object",
      "required": [
        "notification_rendering_definition_id",
        "notification_rendering_definition_revision_id"
      ],
      "properties": {
        "notification_rendering_definition_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "notification_rendering_definition_revision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "additionalProperties": false
    },
    "useScope": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "notification_profile_id"
          ],
          "properties": {
            "kind": {
              "const": "profile"
            },
            "notification_profile_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "direct_policy"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "destination": {
      "type": "object",
      "required": [
        "recipient",
        "delivery_target_id",
        "channel",
        "adapter_name",
        "destination_source",
        "target_ref"
      ],
      "properties": {
        "recipient": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "subject_id"
              ],
              "properties": {
                "kind": {
                  "const": "subject"
                },
                "subject_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind",
                "group_id"
              ],
              "properties": {
                "kind": {
                  "const": "subject_group"
                },
                "group_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "delivery_target_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "adapter_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "destination_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "target_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": [
        "selection_key",
        "facet_key",
        "facet_schema_revision_id",
        "field_key",
        "label",
        "projection"
      ],
      "properties": {
        "selection_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "facet_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "facet_schema_revision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "field_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "projection": {
          "enum": [
            "value",
            "location_label"
          ]
        }
      },
      "additionalProperties": false
    },
    "revision": {
      "type": "object",
      "required": [
        "display_name",
        "description",
        "compatible_item_types",
        "base_rendering_contract",
        "base_rendering_profile",
        "selections"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "compatible_item_types": {
          "type": "array",
          "items": {
            "enum": [
              "event",
              "task"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "base_rendering_contract": {
          "const": "spine.notification-rendering.v1"
        },
        "base_rendering_profile": {
          "const": "spine.notification-rendering.concise-en-ca.v1"
        },
        "selections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "notification-rendering-definition-types.schema.json#/$defs/selection"
          }
        }
      },
      "additionalProperties": false
    },
    "disclosureScope": {
      "type": "object",
      "required": [
        "item_owner",
        "definition",
        "approved_selection_keys",
        "use_scope",
        "destination",
        "permitted_location_ids"
      ],
      "properties": {
        "item_owner": {
          "$ref": "notification-rendering-definition-types.schema.json#/$defs/owner"
        },
        "definition": {
          "$ref": "notification-rendering-definition-types.schema.json#/$defs/definitionReference"
        },
        "approved_selection_keys": {
          "type": "array",
          "items": {
            "$ref": "notification-rendering-definition-types.schema.json#/$defs/key"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "use_scope": {
          "$ref": "notification-rendering-definition-types.schema.json#/$defs/useScope"
        },
        "destination": {
          "$ref": "notification-rendering-definition-types.schema.json#/$defs/destination"
        },
        "permitted_location_ids": {
          "type": "array",
          "items": {
            "$ref": "notification-rendering-definition-types.schema.json#/$defs/id"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "notification_profile_id",
            "notification_profile_revision_id",
            "template_key"
          ],
          "properties": {
            "kind": {
              "enum": [
                "profile_template",
                "profile_replacement"
              ]
            },
            "notification_profile_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "notification_profile_revision_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "template_key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "custom_addition"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "direct"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "authoringSelection": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "ordinary"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "definition",
            "authorization",
            "effective_selection_keys"
          ],
          "properties": {
            "kind": {
              "const": "definition"
            },
            "definition": {
              "$ref": "notification-rendering-definition-types.schema.json#/$defs/definitionReference"
            },
            "authorization": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "resolution"
                  ],
                  "properties": {
                    "resolution": {
                      "const": "unique_match"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "resolution",
                    "disclosure_authorization_id"
                  ],
                  "properties": {
                    "resolution": {
                      "const": "exact"
                    },
                    "disclosure_authorization_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "effective_selection_keys": {
              "type": "array",
              "items": {
                "$ref": "notification-rendering-definition-types.schema.json#/$defs/key"
              },
              "minItems": 0,
              "maxItems": 8,
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "policyPresentation": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "ordinary"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "definition",
            "disclosure_authorization_id",
            "disclosure_scope_hash",
            "effective_selection_keys",
            "origin"
          ],
          "properties": {
            "kind": {
              "const": "definition"
            },
            "definition": {
              "$ref": "notification-rendering-definition-types.schema.json#/$defs/definitionReference"
            },
            "disclosure_authorization_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "disclosure_scope_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "effective_selection_keys": {
              "type": "array",
              "items": {
                "$ref": "notification-rendering-definition-types.schema.json#/$defs/key"
              },
              "minItems": 0,
              "maxItems": 8,
              "uniqueItems": true
            },
            "origin": {
              "$ref": "notification-rendering-definition-types.schema.json#/$defs/origin"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "command_id",
        "actor_subject_id",
        "action_timestamp_utc"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "actor_subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "action_timestamp_utc": {
          "$ref": "notification-rendering-definition-types.schema.json#/$defs/utcTimestamp"
        }
      },
      "additionalProperties": false
    },
    "definitionRecord": {
      "type": "object",
      "required": [
        "notification_rendering_definition_id",
        "owner",
        "definition_key",
        "status",
        "current_revision_id",
        "notification_rendering_definition_revision_id",
        "revision_number",
        "revision",
        "definition_hash",
        "created",
        "published",
        "retired"
      ],
      "properties": {
        "notification_rendering_definition_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "owner": {
          "$ref": "notification-rendering-definition-types.schema.json#/$defs/owner"
        },
        "definition_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "status": {
          "enum": [
            "active",
            "retired"
          ]
        },
        "current_revision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "notification_rendering_definition_revision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_number": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "revision": {
          "$ref": "notification-rendering-definition-types.schema.json#/$defs/revision"
        },
        "definition_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "created": {
          "$ref": "notification-rendering-definition-types.schema.json#/$defs/provenance"
        },
        "published": {
          "$ref": "notification-rendering-definition-types.schema.json#/$defs/provenance"
        },
        "retired": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "reason_code",
                "provenance"
              ],
              "properties": {
                "reason_code": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "provenance": {
                  "$ref": "notification-rendering-definition-types.schema.json#/$defs/provenance"
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "authorizationRecord": {
      "type": "object",
      "required": [
        "disclosure_authorization_id",
        "scope",
        "scope_hash",
        "status",
        "created",
        "revoked"
      ],
      "properties": {
        "disclosure_authorization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scope": {
          "$ref": "notification-rendering-definition-types.schema.json#/$defs/disclosureScope"
        },
        "scope_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "active",
            "revoked"
          ]
        },
        "created": {
          "$ref": "notification-rendering-definition-types.schema.json#/$defs/provenance"
        },
        "revoked": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "reason_code",
                "provenance"
              ],
              "properties": {
                "reason_code": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "provenance": {
                  "$ref": "notification-rendering-definition-types.schema.json#/$defs/provenance"
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
