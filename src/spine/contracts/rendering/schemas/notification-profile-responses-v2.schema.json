{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/notification-profile-responses-v2.schema.json",
  "title": "Spine notification-profile-responses-v2 (source only)",
  "$defs": {
    "receipt": {
      "type": "object",
      "required": [
        "command_receipt_id",
        "command_id",
        "effect",
        "semantic_facts_hash",
        "created_at_utc"
      ],
      "properties": {
        "command_receipt_id": {
          "$ref": "notification-types.schema.json#/$defs/id"
        },
        "command_id": {
          "$ref": "notification-types.schema.json#/$defs/id"
        },
        "effect": {
          "enum": [
            "notification_profile_created",
            "notification_profile_revised"
          ]
        },
        "semantic_facts_hash": {
          "$ref": "notification-types.schema.json#/$defs/sha256"
        },
        "created_at_utc": {
          "$ref": "notification-types.schema.json#/$defs/utcTimestamp"
        }
      },
      "additionalProperties": false
    },
    "revision": {
      "type": "object",
      "required": [
        "notification_profile_revision_id",
        "revision_number",
        "revision_contract",
        "normalized_revision_hash",
        "content"
      ],
      "properties": {
        "notification_profile_revision_id": {
          "$ref": "notification-types.schema.json#/$defs/id"
        },
        "revision_number": {
          "$ref": "notification-types.schema.json#/$defs/decimalPositive"
        },
        "revision_contract": {
          "enum": [
            "spine.notification-profiles.v1",
            "spine.notification-profiles.v2"
          ]
        },
        "normalized_revision_hash": {
          "$ref": "notification-types.schema.json#/$defs/sha256"
        },
        "content": {
          "oneOf": [
            {
              "$ref": "#/$defs/historicalRevision"
            },
            {
              "$ref": "notification-profile-types-v2.schema.json#/$defs/normalizedRevision"
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "revision_contract": {
                "const": "spine.notification-profiles.v2"
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "notification-profile-types-v2.schema.json#/$defs/normalizedRevision"
              }
            }
          },
          "else": {
            "properties": {
              "content": {
                "$ref": "#/$defs/historicalRevision"
              }
            }
          }
        }
      ]
    },
    "profile": {
      "type": "object",
      "required": [
        "notification_profile_id",
        "owner",
        "profile_key",
        "display_name",
        "description",
        "status",
        "current_revision_id",
        "revision"
      ],
      "properties": {
        "notification_profile_id": {
          "$ref": "notification-types.schema.json#/$defs/id"
        },
        "owner": {
          "$ref": "notification-profile-types.schema.json#/$defs/owner"
        },
        "profile_key": {
          "$ref": "notification-profile-types.schema.json#/$defs/key"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "active",
            "retired"
          ]
        },
        "current_revision_id": {
          "$ref": "notification-types.schema.json#/$defs/id"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      },
      "additionalProperties": false
    },
    "create": {
      "type": "object",
      "required": [
        "ok",
        "command",
        "response_contract",
        "effect",
        "notification_profile_id",
        "notification_profile_revision_id",
        "revision_number",
        "profile_key",
        "status",
        "normalized_revision_hash",
        "receipt"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "command": {
          "const": "notification_profile.create"
        },
        "response_contract": {
          "const": "spine.notification-profiles.v2"
        },
        "effect": {
          "const": "notification_profile_created"
        },
        "notification_profile_id": {
          "$ref": "notification-types.schema.json#/$defs/id"
        },
        "notification_profile_revision_id": {
          "$ref": "notification-types.schema.json#/$defs/id"
        },
        "revision_number": {
          "$ref": "notification-types.schema.json#/$defs/decimalPositive"
        },
        "profile_key": {
          "$ref": "notification-profile-types.schema.json#/$defs/key"
        },
        "status": {
          "const": "active"
        },
        "normalized_revision_hash": {
          "$ref": "notification-types.schema.json#/$defs/sha256"
        },
        "receipt": {
          "$ref": "#/$defs/receipt"
        },
        "dry_run": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "revise": {
      "type": "object",
      "required": [
        "ok",
        "command",
        "response_contract",
        "effect",
        "notification_profile_id",
        "notification_profile_revision_id",
        "revision_number",
        "status",
        "normalized_revision_hash",
        "receipt"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "command": {
          "const": "notification_profile.revise"
        },
        "response_contract": {
          "const": "spine.notification-profiles.v2"
        },
        "effect": {
          "const": "notification_profile_revised"
        },
        "notification_profile_id": {
          "$ref": "notification-types.schema.json#/$defs/id"
        },
        "notification_profile_revision_id": {
          "$ref": "notification-types.schema.json#/$defs/id"
        },
        "revision_number": {
          "$ref": "notification-types.schema.json#/$defs/decimalPositive"
        },
        "status": {
          "const": "active"
        },
        "normalized_revision_hash": {
          "$ref": "notification-types.schema.json#/$defs/sha256"
        },
        "receipt": {
          "$ref": "#/$defs/receipt"
        },
        "dry_run": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "show": {
      "type": "object",
      "required": [
        "ok",
        "command",
        "response_contract",
        "notification_profile"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "command": {
          "const": "notification_profile.show"
        },
        "response_contract": {
          "const": "spine.notification-profiles.v2"
        },
        "notification_profile": {
          "$ref": "#/$defs/profile"
        },
        "dry_run": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "list": {
      "type": "object",
      "required": [
        "ok",
        "command",
        "response_contract",
        "entries",
        "count",
        "catalog_snapshot_hash",
        "has_more",
        "next_cursor"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "command": {
          "const": "notification_profile.list"
        },
        "response_contract": {
          "const": "spine.notification-profiles.v2"
        },
        "entries": {
          "type": "array",
          "minItems": 0,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/profile"
          }
        },
        "count": {
          "$ref": "notification-types.schema.json#/$defs/decimalNonNegative"
        },
        "catalog_snapshot_hash": {
          "$ref": "notification-types.schema.json#/$defs/sha256"
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "dry_run": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "historicalRevision": {
      "type": "object",
      "required": [
        "compatible_item_types",
        "templates"
      ],
      "properties": {
        "compatible_item_types": {
          "$ref": "notification-profile-types.schema.json#/$defs/itemTypes"
        },
        "templates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "template_key",
              "schedule",
              "late_handling",
              "normalized_template_hash"
            ],
            "properties": {
              "template_key": {
                "$ref": "notification-profile-types.schema.json#/$defs/key"
              },
              "schedule": {
                "$ref": "notification-types.schema.json#/$defs/schedule"
              },
              "late_handling": {
                "$ref": "notification-types.schema.json#/$defs/lateHandling"
              },
              "normalized_template_hash": {
                "$ref": "notification-types.schema.json#/$defs/sha256"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
