# Copy to /etc/spine/worker.env and set host-specific values.
# Do not commit real secrets.

SPINE_DB=/var/lib/spine/ledger.sqlite
SPINE_STATE_DIR=/var/lib/spine/worker
TICKERD_SRC=/home/agent/projects/apps/tickerd/src

# Worker binding configuration.
SPINE_WORKER_BINDINGS=openclaw
SPINE_OPENCLAW_SENDER=fake

# Gateway sender configuration. Required only for --openclaw-sender gateway.
SPINE_OPENCLAW_COMMAND=openclaw
SPINE_OPENCLAW_GATEWAY_URL=
SPINE_OPENCLAW_GATEWAY_TOKEN=
SPINE_OPENCLAW_GATEWAY_PASSWORD=
SPINE_OPENCLAW_GATEWAY_TIMEOUT_MS=10000
SPINE_OPENCLAW_RETRY_DELAY_SECONDS=300
