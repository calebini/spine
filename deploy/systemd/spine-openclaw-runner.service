[Unit]
Description=Spine OpenClaw runner
Wants=network-online.target
After=network-online.target openclaw-gateway.service
Requires=openclaw-gateway.service

[Service]
Type=simple
User=agent
WorkingDirectory=/home/agent/projects/apps/spine
EnvironmentFile=/etc/spine/openclaw-runner.env

# Safe first boot: observe-only mode scans eligible work without executing side effects.
ExecStart=/usr/bin/env PYTHONPATH=${TICKERD_SRC} /home/agent/projects/apps/spine/.venv/bin/spine-openclaw-runner --db ${SPINE_DB} --state-dir ${SPINE_STATE_DIR} --mode observe_only --sender fake --trace-id spine-openclaw-runner

# Cutover shape, after observe-only and fake active trials have passed:
# ExecStart=/usr/bin/env PYTHONPATH=${TICKERD_SRC} /home/agent/projects/apps/spine/.venv/bin/spine-openclaw-runner --db ${SPINE_DB} --state-dir ${SPINE_STATE_DIR} --mode active --sender gateway --allow-real-send --trace-id spine-openclaw-runner

Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
