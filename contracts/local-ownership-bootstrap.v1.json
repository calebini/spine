    {
      "case": "provisioning_epoch_overflow_on_required_advance",
      "code": "admission_unavailable"
    },
    {
      "case": "stale_expected_epoch",
      "code": "access_changed"
    },
    {
      "case": "changed_plan_or_references_or_conflicts",
      "code": "domain_conflict"
    },
    {
      "case": "incompatible_replay",
      "code": "command_id_unavailable"
    },
    {
      "case": "protected_local_or_absent",
      "code": "admission_unavailable",
      "http_status": "503"
    }
  ],
  "migration_contract": "contracts/local-ownership-bootstrap-migration.v1.json",
  "fixture_manifest": "contracts/local-ownership-bootstrap-fixture-manifest.json",
  "runtime_obligations": [
    {
      "id": "LOB-01",
      "requirement": "Real first-owner and multi-owner-page transactions: epoch 1; no account/membership/grant/disclosure creation.",
      "status": "pending_runtime"
    },
    {
      "id": "LOB-02",
      "requirement": "Real outer/dry-run and each unit-savepoint fault boundary restore SQL and the transaction-local once marker.",
      "status": "pending_runtime"
    },
    {
      "id": "LOB-03",
      "requirement": "Real configured realm preservation and exactly one epoch advance across combined authorization writers.",
      "status": "pending_runtime"
    },
    {
      "id": "LOB-04",
      "requirement": "Actual v3 promotion, eligible-operator/no-lockout, stale witness and compatible/incompatible replay; frozen v1/v2 preservation.",
      "status": "pending_runtime"
    },
    {
      "id": "LOB-05",
      "requirement": "Protected readiness/chooser/read/write refuses absent/local posture without unsupported modes or private state leakage.",
      "status": "pending_runtime"
    },
    {
      "id": "LOB-06",
      "requirement": "Physical first-owner/first-owner and owner/provisioning interleavings; one singleton, monotone epochs, loser replans.",
      "status": "pending_runtime"
    },
    {
      "id": "LOB-07",
      "requirement": "Actual rebuild with account FK children; row/object preservation; every migration fault, FK restoration and old-writer refusal.",
      "status": "pending_runtime"
    },
    {
      "id": "LOB-08",
      "requirement": "Missing/malformed instance or access state, overflow and object drift fail closed; bounded routine SQL without deep scans.",
      "status": "pending_runtime"
    }
  ]
}
