{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/recurrence-types.schema.json",
  "title": "Spine Recurrence Shared Types",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "decimalPositive": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "decimalNonNegative": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "localDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "localInstant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },
    "scheduledFact": {
      "oneOf": [
        { "$ref": "#/$defs/localDate" },
        { "$ref": "#/$defs/localInstant" },
        { "$ref": "#/$defs/utcTimestamp" }
      ]
    },
    "weekday": {
      "enum": ["MO", "TU", "WE", "TH", "FR", "SA", "SU"]
    },
    "selectorFamilyRules": {
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": { "frequency": { "enum": ["MONTHLY", "YEARLY"] } },
            "required": ["frequency"]
          },
          "then": {
            "not": {
              "required": ["by_month_day", "by_weekday"]
            }
          }
        },
        {
          "if": {
            "required": ["by_set_position"]
          },
          "then": {
            "required": ["by_weekday"]
          }
        }
      ]
    },
    "endCondition": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "unbounded" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "count"],
          "properties": {
            "kind": { "const": "count" },
            "count": { "$ref": "#/$defs/decimalPositive" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "until"],
          "properties": {
            "kind": { "const": "until" },
            "until": { "$ref": "#/$defs/scheduledFact" }
          },
          "additionalProperties": false
        }
      ]
    },
    "authoringRule": {
      "type": "object",
      "required": ["frequency", "seed", "start_bound", "end_condition"],
      "properties": {
        "frequency": { "enum": ["DAILY", "WEEKLY", "MONTHLY", "YEARLY"] },
        "interval": { "$ref": "#/$defs/decimalPositive" },
        "seed": { "$ref": "#/$defs/scheduledFact" },
        "start_bound": { "$ref": "#/$defs/scheduledFact" },
        "end_condition": { "$ref": "#/$defs/endCondition" },
        "by_month": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^([1-9]|1[0-2])$" }
        },
        "by_month_day": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^-?([1-9]|[12][0-9]|3[01])$" }
        },
        "by_weekday": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/weekday" }
        },
        "by_set_position": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^-?([1-9]|[1-9][0-9]|[12][0-9]{2}|3[0-5][0-9]|36[0-6])$" }
        },
        "week_start": { "$ref": "#/$defs/weekday" },
        "segment_label": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        { "$ref": "#/$defs/selectorFamilyRules" },
        {
          "if": { "properties": { "frequency": { "const": "DAILY" } }, "required": ["frequency"] },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["by_month"] },
                { "required": ["by_month_day"] },
                { "required": ["by_weekday"] },
                { "required": ["by_set_position"] },
                { "required": ["week_start"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "frequency": { "const": "WEEKLY" } }, "required": ["frequency"] },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["by_month"] },
                { "required": ["by_month_day"] },
                { "required": ["by_set_position"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "frequency": { "const": "MONTHLY" } }, "required": ["frequency"] },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["by_month"] },
                { "required": ["week_start"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "frequency": { "const": "YEARLY" } }, "required": ["frequency"] },
          "then": { "not": { "required": ["week_start"] } }
        }
      ],
      "additionalProperties": false
    },
    "authoringSegment": {
      "type": "object",
      "required": ["segment_label", "active_start"],
      "properties": {
        "segment_label": { "type": "string", "minLength": 1 },
        "active_start": { "$ref": "#/$defs/scheduledFact" },
        "active_end": { "$ref": "#/$defs/scheduledFact" },
        "reason_code": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "authoringRdate": {
      "type": "object",
      "required": ["scheduled_fact"],
      "properties": {
        "scheduled_fact": { "$ref": "#/$defs/scheduledFact" },
        "segment_label": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "commonDetailPatch": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": ["string", "null"] },
        "source_ref": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "eventDetailPatch": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "all_day": { "type": "boolean" },
        "end_scheduled_fact": {
          "oneOf": [
            { "$ref": "#/$defs/scheduledFact" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "taskDetailPatch": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "defer_until_scheduled_fact": {
          "oneOf": [
            { "$ref": "#/$defs/scheduledFact" },
            { "type": "null" }
          ]
        },
        "priority": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "overrideInput": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "expressed_scheduled_fact": { "$ref": "#/$defs/scheduledFact" },
        "common_detail_patch": { "$ref": "#/$defs/commonDetailPatch" },
        "event_detail_patch": { "$ref": "#/$defs/eventDetailPatch" },
        "task_detail_patch": { "$ref": "#/$defs/taskDetailPatch" },
        "lifecycle": { "enum": ["active", "cancelled", "completed"] },
        "reason_code": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["expressed_scheduled_fact"] },
        { "required": ["common_detail_patch"] },
        { "required": ["event_detail_patch"] },
        { "required": ["task_detail_patch"] },
        { "required": ["lifecycle"] }
      ],
      "additionalProperties": false
    },
    "normalizedSegment": {
      "type": "object",
      "required": ["segment_id", "segment_index", "active_start", "source_revision_id", "status"],
      "properties": {
        "segment_id": { "$ref": "#/$defs/id" },
        "segment_index": { "$ref": "#/$defs/decimalNonNegative" },
        "active_start": { "$ref": "#/$defs/scheduledFact" },
        "active_end": { "$ref": "#/$defs/scheduledFact" },
        "source_revision_id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["active", "superseded", "retired"] },
        "lineage_parent_segment_id": { "$ref": "#/$defs/id" },
        "created_by_command_id": { "$ref": "#/$defs/id" },
        "reason_code": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "normalizedRule": {
      "type": "object",
      "required": ["rule_id", "segment_id", "frequency", "interval", "seed", "start_bound", "end_condition", "status"],
      "properties": {
        "rule_id": { "$ref": "#/$defs/id" },
        "segment_id": { "$ref": "#/$defs/id" },
        "frequency": { "enum": ["DAILY", "WEEKLY", "MONTHLY", "YEARLY"] },
        "interval": { "$ref": "#/$defs/decimalPositive" },
        "seed": { "$ref": "#/$defs/scheduledFact" },
        "start_bound": { "$ref": "#/$defs/scheduledFact" },
        "end_condition": { "$ref": "#/$defs/endCondition" },
        "by_month": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^([1-9]|1[0-2])$" }
        },
        "by_month_day": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^-?([1-9]|[12][0-9]|3[01])$" }
        },
        "by_weekday": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/weekday" }
        },
        "by_set_position": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^-?([1-9]|[1-9][0-9]|[12][0-9]{2}|3[0-5][0-9]|36[0-6])$" }
        },
        "week_start": { "$ref": "#/$defs/weekday" },
        "status": { "enum": ["active", "superseded"] }
      },
      "allOf": [
        { "$ref": "#/$defs/selectorFamilyRules" },
        {
          "if": { "properties": { "frequency": { "const": "DAILY" } }, "required": ["frequency"] },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["by_month"] },
                { "required": ["by_month_day"] },
                { "required": ["by_weekday"] },
                { "required": ["by_set_position"] },
                { "required": ["week_start"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "frequency": { "const": "WEEKLY" } }, "required": ["frequency"] },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["by_month"] },
                { "required": ["by_month_day"] },
                { "required": ["by_set_position"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "frequency": { "const": "MONTHLY" } }, "required": ["frequency"] },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["by_month"] },
                { "required": ["week_start"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "frequency": { "const": "YEARLY" } }, "required": ["frequency"] },
          "then": { "not": { "required": ["week_start"] } }
        }
      ],
      "additionalProperties": false
    },
    "normalizedRdate": {
      "type": "object",
      "required": ["rdate_id", "segment_id", "scheduled_fact", "status"],
      "properties": {
        "rdate_id": { "$ref": "#/$defs/id" },
        "segment_id": { "$ref": "#/$defs/id" },
        "scheduled_fact": { "$ref": "#/$defs/scheduledFact" },
        "status": { "enum": ["active", "superseded"] }
      },
      "additionalProperties": false
    },
    "normalizedExdate": {
      "type": "object",
      "required": ["exdate_id", "segment_id", "target_occurrence_key", "target_occurrence_selector", "scheduled_fact", "reason_code", "status"],
      "properties": {
        "exdate_id": { "$ref": "#/$defs/id" },
        "segment_id": { "$ref": "#/$defs/id" },
        "target_occurrence_key": { "$ref": "#/$defs/id" },
        "target_occurrence_selector": { "type": "object" },
        "scheduled_fact": { "$ref": "#/$defs/scheduledFact" },
        "reason_code": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "superseded"] },
        "prior_target_occurrence_key": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "normalizedOverride": {
      "type": "object",
      "required": ["override_id", "segment_id", "target_occurrence_key", "target_occurrence_selector", "override_kind", "revision_key", "status"],
      "properties": {
        "override_id": { "$ref": "#/$defs/id" },
        "segment_id": { "$ref": "#/$defs/id" },
        "target_occurrence_key": { "$ref": "#/$defs/id" },
        "target_occurrence_selector": { "type": "object" },
        "override_kind": { "enum": ["move", "detail_patch", "lifecycle", "move_detail_patch", "move_lifecycle", "detail_patch_lifecycle", "move_detail_patch_lifecycle"] },
        "revision_key": { "$ref": "#/$defs/id" },
        "status": { "enum": ["active", "superseded"] },
        "prior_target_occurrence_key": { "$ref": "#/$defs/id" },
        "expressed_scheduled_fact": { "$ref": "#/$defs/scheduledFact" },
        "common_detail_patch": { "$ref": "#/$defs/commonDetailPatch" },
        "event_detail_patch": { "$ref": "#/$defs/eventDetailPatch" },
        "task_detail_patch": { "$ref": "#/$defs/taskDetailPatch" },
        "lifecycle": { "enum": ["active", "cancelled", "completed"] },
        "reason_code": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
