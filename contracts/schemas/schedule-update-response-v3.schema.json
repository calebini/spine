{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/schedule-update-response-v3.schema.json",
  "title": "Spine Schedule Update v3 Response (source only)",
  "type": "object",
  "required": [
    "ok",
    "command",
    "response_contract",
    "effect",
    "command_id",
    "command_receipt_id",
    "item_id",
    "item_type",
    "target_version",
    "current_version",
    "truth_changed",
    "work_changed",
    "changed_dimensions",
    "scheduled_time",
    "policies",
    "disabled_notification_intent_ids",
    "work_reconciliation",
    "materialization",
    "phases",
    "receipt",
    "archetype_action",
    "notification_profile_action",
    "presentation_changes"
  ],
  "properties": {
    "ok": {
      "const": true
    },
    "command": {
      "const": "schedule.update"
    },
    "response_contract": {
      "const": "spine.schedule-update-response.v3"
    },
    "effect": {
      "enum": [
        "schedule_updated_and_reconciled",
        "schedule_updated",
        "schedule_reconciled",
        "schedule_update_noop",
        "schedule_update_replay"
      ]
    },
    "command_id": {
      "$ref": "notification-types.schema.json#/$defs/id"
    },
    "command_receipt_id": {
      "$ref": "notification-types.schema.json#/$defs/id"
    },
    "audit_id": {
      "$ref": "notification-types.schema.json#/$defs/id"
    },
    "item_id": {
      "$ref": "notification-types.schema.json#/$defs/id"
    },
    "item_type": {
      "enum": [
        "event",
        "task"
      ]
    },
    "target_version": {
      "$ref": "notification-types.schema.json#/$defs/decimalPositive"
    },
    "current_version": {
      "$ref": "notification-types.schema.json#/$defs/decimalPositive"
    },
    "truth_changed": {
      "type": "boolean"
    },
    "work_changed": {
      "type": "boolean"
    },
    "changed_dimensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "item",
          "primary_location",
          "scheduled_time",
          "recurrence",
          "delivery",
          "reminders",
          "archetype",
          "notification_profile",
          "policy_presentations"
        ]
      }
    },
    "scheduled_time": {
      "$ref": "schedule-create-response.schema.json#/$defs/resolvedSchedule"
    },
    "primary_location_change": {
      "$ref": "schedule-primary-location-types.schema.json#/$defs/updateChange"
    },
    "recurrence": {
      "$ref": "#/$defs/recurrenceSummary"
    },
    "policies": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/policyResult"
      }
    },
    "disabled_notification_intent_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "notification-types.schema.json#/$defs/id"
      }
    },
    "work_reconciliation": {
      "$ref": "schedule-operations-types.schema.json#/$defs/workReconciliation"
    },
    "materialization": {
      "oneOf": [
        {
          "$ref": "schedule-create-response.schema.json#/$defs/materializationNone"
        },
        {
          "$ref": "schedule-create-response.schema.json#/$defs/materializationBounded"
        }
      ]
    },
    "phases": {
      "$ref": "#/$defs/phases"
    },
    "receipt": {
      "$ref": "#/$defs/receipt"
    },
    "dry_run": {
      "const": true
    },
    "archetype_action": {
      "enum": [
        "retain",
        "clear",
        "select"
      ]
    },
    "notification_profile_action": {
      "enum": [
        "retain",
        "clear",
        "explicit",
        "archetype_default",
        "upgrade_current_revision"
      ]
    },
    "notification_profile": {
      "oneOf": [
        {
          "$ref": "notification-profile-application-v2.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "presentation_changes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "$ref": "notification-rendering-integration-types.schema.json#/$defs/presentationChange"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "receipt": {
            "properties": {
              "effect": {
                "const": "schedule_update_noop"
              }
            },
            "required": [
              "effect"
            ]
          }
        },
        "required": [
          "receipt"
        ]
      },
      "then": {
        "not": {
          "required": [
            "audit_id"
          ]
        }
      },
      "else": {
        "required": [
          "audit_id"
        ]
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "recurrenceSummary": {
      "type": "object",
      "required": [
        "recurrence_set_id",
        "recurrence_revision_id",
        "revision_number",
        "normalized_recurrence_set_hash",
        "diagnostics"
      ],
      "properties": {
        "recurrence_set_id": {
          "$ref": "notification-types.schema.json#/$defs/id"
        },
        "recurrence_revision_id": {
          "$ref": "notification-types.schema.json#/$defs/id"
        },
        "revision_number": {
          "$ref": "notification-types.schema.json#/$defs/decimalPositive"
        },
        "normalized_recurrence_set_hash": {
          "$ref": "notification-types.schema.json#/$defs/sha256"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "phases": {
      "type": "object",
      "required": [
        "truth",
        "provenance",
        "opportunities",
        "work",
        "delivery"
      ],
      "properties": {
        "truth": {
          "enum": [
            "updated",
            "unchanged"
          ]
        },
        "provenance": {
          "enum": [
            "regenerated",
            "retained",
            "not_applicable"
          ]
        },
        "opportunities": {
          "enum": [
            "expanded",
            "not_requested"
          ]
        },
        "work": {
          "enum": [
            "none",
            "reconciled",
            "materialized",
            "reconciled_and_materialized"
          ]
        },
        "delivery": {
          "const": "not_attempted"
        }
      },
      "additionalProperties": false
    },
    "policyResult": {
      "type": "object",
      "required": [
        "policy_key",
        "notification_intent_id",
        "notification_policy_id",
        "notification_schedule_id",
        "normalized_notification_schedule_hash",
        "status",
        "effect",
        "presentation",
        "presentation_hash"
      ],
      "properties": {
        "policy_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}(?![\\s\\S])"
        },
        "notification_intent_id": {
          "$ref": "notification-types.schema.json#/$defs/id"
        },
        "notification_policy_id": {
          "$ref": "notification-types.schema.json#/$defs/id"
        },
        "notification_schedule_id": {
          "$ref": "notification-types.schema.json#/$defs/id"
        },
        "normalized_notification_schedule_hash": {
          "$ref": "notification-types.schema.json#/$defs/sha256"
        },
        "status": {
          "const": "active"
        },
        "effect": {
          "enum": [
            "retained",
            "updated",
            "created"
          ]
        },
        "presentation": {
          "$ref": "notification-rendering-definition-types.schema.json#/$defs/policyPresentation"
        },
        "presentation_hash": {
          "$ref": "notification-types.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "required": [
        "receipt_contract",
        "command_receipt_id",
        "effect",
        "semantic_facts_hash",
        "created_at_utc"
      ],
      "properties": {
        "receipt_contract": {
          "const": "spine.schedule-update-receipt.v3"
        },
        "command_receipt_id": {
          "$ref": "notification-types.schema.json#/$defs/id"
        },
        "effect": {
          "enum": [
            "schedule_updated_and_reconciled",
            "schedule_updated",
            "schedule_reconciled",
            "schedule_update_noop"
          ]
        },
        "semantic_facts_hash": {
          "$ref": "notification-types.schema.json#/$defs/sha256"
        },
        "created_at_utc": {
          "$ref": "notification-types.schema.json#/$defs/utcTimestamp"
        }
      },
      "additionalProperties": false
    }
  }
}
