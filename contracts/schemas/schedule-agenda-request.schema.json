{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/schedule-agenda-request.schema.json",
  "title": "Spine Agenda Show Request v1",
  "type": "object",
  "required": [
    "contract_version", "evaluated_at_utc", "range_start_local", "range_end_local",
    "timezone", "timezone_database_version", "limit"
  ],
  "properties": {
    "contract_version": { "const": "spine.schedule-agenda.v1" },
    "evaluated_at_utc": { "$ref": "notification-types.schema.json#/$defs/utcTimestamp" },
    "range_start_local": { "$ref": "schedule-create-request.schema.json#/$defs/localDateTime" },
    "range_end_local": { "$ref": "schedule-create-request.schema.json#/$defs/localDateTime" },
    "timezone": { "type": "string", "minLength": 1 },
    "timezone_database_version": { "$ref": "schedule-create-request.schema.json#/$defs/timezoneDatabaseVersionDirective" },
    "item_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["event", "task"] }
    },
    "item_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "notification-types.schema.json#/$defs/id" }
    },
    "include_terminal": { "type": "boolean" },
    "include": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["notification_summary", "work_summary", "primary_location"] }
    },
    "include_diagnostics": { "type": "boolean" },
    "limit": {
      "type": "string",
      "pattern": "^([1-9]|[1-9][0-9]|[1-9][0-9]{2}|1000)$"
    },
    "cursor": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
