{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/schedule-binding-list-request.schema.json",
  "title": "Spine Temporal Binding List Request v1",
  "type": "object",
  "required": ["contract_version"],
  "properties": {
    "contract_version": { "const": "spine.schedule-binding-list.v1" },
    "source_item_id": { "$ref": "notification-types.schema.json#/$defs/id" },
    "target_item_id": { "$ref": "notification-types.schema.json#/$defs/id" },
    "binding_mode": { "enum": ["snapshot", "follow_source"] },
    "binding_status": { "enum": ["active", "retired"] },
    "binding_states": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "relative-temporal-binding-types.schema.json#/$defs/bindingState" }
    },
    "limit": { "type": "string", "pattern": "^([1-9]|[1-9][0-9]{1,2}|1000)$" },
    "cursor": { "type": "string", "minLength": 1 },
    "bounded": { "type": "boolean" }
  },
  "anyOf": [
    { "required": ["source_item_id"] },
    { "required": ["target_item_id"] },
    { "properties": { "bounded": { "const": true } }, "required": ["bounded"] }
  ],
  "additionalProperties": false
}
