{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/notification-rendering-integration-types.schema.json",
  "title": "Spine notification-rendering-integration-types (specified, not implemented)",
  "$defs": {
    "templateRendering": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "ordinary"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "definition"
          ],
          "properties": {
            "kind": {
              "const": "definition"
            },
            "definition": {
              "$ref": "notification-rendering-definition-types.schema.json#/$defs/definitionReference"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "application": {
      "type": "object",
      "required": [
        "source_kind",
        "source_key",
        "selection"
      ],
      "properties": {
        "source_kind": {
          "enum": [
            "profile_template",
            "custom_addition"
          ]
        },
        "source_key": {
          "$ref": "notification-profile-types.schema.json#/$defs/key"
        },
        "selection": {
          "$ref": "notification-rendering-definition-types.schema.json#/$defs/authoringSelection"
        }
      },
      "additionalProperties": false
    },
    "applications": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "$ref": "notification-rendering-integration-types.schema.json#/$defs/application"
      }
    },
    "policyEdit": {
      "type": "object",
      "required": [
        "notification_policy_id",
        "selection"
      ],
      "properties": {
        "notification_policy_id": {
          "$ref": "notification-types.schema.json#/$defs/id"
        },
        "selection": {
          "$ref": "notification-rendering-definition-types.schema.json#/$defs/authoringSelection"
        }
      },
      "additionalProperties": false
    },
    "policyEdits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "notification-rendering-integration-types.schema.json#/$defs/policyEdit"
      }
    },
    "presentationFields": {
      "type": "object",
      "required": [
        "presentation",
        "presentation_hash"
      ],
      "properties": {
        "presentation": {
          "$ref": "notification-rendering-definition-types.schema.json#/$defs/policyPresentation"
        },
        "presentation_hash": {
          "$ref": "notification-types.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "presentationChange": {
      "type": "object",
      "required": [
        "source_policy_id",
        "policy_id",
        "before_hash",
        "after_hash"
      ],
      "properties": {
        "source_policy_id": {
          "$ref": "notification-types.schema.json#/$defs/id"
        },
        "policy_id": {
          "$ref": "notification-types.schema.json#/$defs/id"
        },
        "before_hash": {
          "$ref": "notification-types.schema.json#/$defs/sha256"
        },
        "after_hash": {
          "$ref": "notification-types.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
