{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/notification-rendering-disclosures-v2.schema.json",
  "title": "Spine attached-field rendering disclosure requests, records and responses",
  "$defs": {
    "disclosureScope": {
      "type": "object",
      "required": [
        "item_owner",
        "definition",
        "approved_selection_keys",
        "use_scope",
        "destination",
        "location_authority"
      ],
      "properties": {
        "item_owner": {
          "$ref": "notification-rendering-definition-types.schema.json#/$defs/owner",
          "not": {
            "properties": {
              "owner_kind": {
                "const": "system"
              }
            },
            "required": [
              "owner_kind"
            ]
          }
        },
        "definition": {
          "$ref": "notification-rendering-definition-types.schema.json#/$defs/definitionReference"
        },
        "approved_selection_keys": {
          "type": "array",
          "items": {
            "$ref": "notification-rendering-definition-types.schema.json#/$defs/key"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "use_scope": {
          "$ref": "notification-rendering-definition-types.schema.json#/$defs/useScope"
        },
        "destination": {
          "$ref": "notification-rendering-definition-types.schema.json#/$defs/destination"
        },
        "location_authority": {
          "const": "attached_field"
        }
      },
      "additionalProperties": false
    },
    "authorizationRecord": {
      "type": "object",
      "required": [
        "disclosure_authorization_id",
        "scope",
        "scope_hash",
        "status",
        "created",
        "revoked"
      ],
      "properties": {
        "disclosure_authorization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scope": {
          "$ref": "#/$defs/disclosureScope"
        },
        "scope_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "active",
            "revoked"
          ]
        },
        "created": {
          "$ref": "notification-rendering-definition-types.schema.json#/$defs/provenance"
        },
        "revoked": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "reason_code",
                "provenance"
              ],
              "properties": {
                "reason_code": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "provenance": {
                  "$ref": "notification-rendering-definition-types.schema.json#/$defs/provenance"
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        }
      },
      "then": {
        "properties": {
          "revoked": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "revoked": {
            "type": "object"
          }
        }
      }
    },
    "provisionRequest": {
      "type": "object",
      "required": [
        "contract_version",
        "command_id",
        "actor_subject_id",
        "action_timestamp_utc",
        "scope"
      ],
      "properties": {
        "contract_version": {
          "const": "spine.notification-rendering-disclosures.v2"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "actor_subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "action_timestamp_utc": {
          "$ref": "notification-rendering-definition-types.schema.json#/$defs/utcTimestamp"
        },
        "scope": {
          "$ref": "#/$defs/disclosureScope"
        }
      },
      "additionalProperties": false
    },
    "provisionResponse": {
      "type": "object",
      "required": [
        "ok",
        "contract_version",
        "command",
        "command_id",
        "changed",
        "replayed",
        "effect",
        "command_receipt_id",
        "audit_id",
        "record"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "contract_version": {
          "const": "spine.notification-rendering-disclosures.v2"
        },
        "command": {
          "const": "notification_rendering_disclosure.provision"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "changed": {
          "type": "boolean"
        },
        "replayed": {
          "type": "boolean"
        },
        "dry_run": {
          "const": true
        },
        "effect": {
          "enum": [
            "rendering_disclosure_provisioned"
          ]
        },
        "command_receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "audit_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "record": {
          "$ref": "#/$defs/authorizationRecord"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "replayed": {
                "const": true
              }
            },
            "required": [
              "replayed"
            ]
          },
          "then": {
            "properties": {
              "changed": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "changed": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "revokeRequest": {
      "type": "object",
      "required": [
        "contract_version",
        "command_id",
        "actor_subject_id",
        "action_timestamp_utc",
        "disclosure_authorization_id",
        "expected_scope_hash",
        "reason_code"
      ],
      "properties": {
        "contract_version": {
          "const": "spine.notification-rendering-disclosures.v2"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "actor_subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "action_timestamp_utc": {
          "$ref": "notification-rendering-definition-types.schema.json#/$defs/utcTimestamp"
        },
        "disclosure_authorization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expected_scope_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        }
      },
      "additionalProperties": false
    },
    "revokeResponse": {
      "type": "object",
      "required": [
        "ok",
        "contract_version",
        "command",
        "command_id",
        "changed",
        "replayed",
        "effect",
        "command_receipt_id",
        "audit_id",
        "record"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "contract_version": {
          "const": "spine.notification-rendering-disclosures.v2"
        },
        "command": {
          "const": "notification_rendering_disclosure.revoke"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "changed": {
          "type": "boolean"
        },
        "replayed": {
          "type": "boolean"
        },
        "dry_run": {
          "const": true
        },
        "effect": {
          "enum": [
            "rendering_disclosure_revoked",
            "rendering_disclosure_revoke_noop"
          ]
        },
        "command_receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "audit_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "record": {
          "$ref": "#/$defs/authorizationRecord"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "replayed": {
                "const": true
              }
            },
            "required": [
              "replayed"
            ]
          },
          "then": {
            "properties": {
              "changed": {
                "const": false
              }
            }
          },
          "else": {
            "if": {
              "properties": {
                "effect": {
                  "enum": [
                    "rendering_disclosure_revoke_noop"
                  ]
                }
              },
              "required": [
                "effect"
              ]
            },
            "then": {
              "properties": {
                "changed": {
                  "const": false
                }
              }
            },
            "else": {
              "properties": {
                "changed": {
                  "const": true
                }
              }
            }
          }
        }
      ]
    },
    "showRequest": {
      "type": "object",
      "required": [
        "contract_version",
        "disclosure_authorization_id"
      ],
      "properties": {
        "contract_version": {
          "const": "spine.notification-rendering-disclosures.v2"
        },
        "disclosure_authorization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "additionalProperties": false
    },
    "showResponse": {
      "type": "object",
      "required": [
        "ok",
        "contract_version",
        "command",
        "record"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "contract_version": {
          "const": "spine.notification-rendering-disclosures.v2"
        },
        "command": {
          "const": "notification_rendering_disclosure.show"
        },
        "record": {
          "$ref": "#/$defs/authorizationRecord"
        },
        "dry_run": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "listRequest": {
      "type": "object",
      "required": [
        "contract_version",
        "owner",
        "status",
        "limit"
      ],
      "properties": {
        "contract_version": {
          "const": "spine.notification-rendering-disclosures.v2"
        },
        "owner": {
          "$ref": "notification-rendering-definition-types.schema.json#/$defs/owner"
        },
        "status": {
          "enum": [
            "active",
            "revoked"
          ]
        },
        "limit": {
          "type": "string",
          "pattern": "^([1-9]|[1-9][0-9]|100)(?![\\s\\S])"
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "additionalProperties": false
    },
    "listResponse": {
      "type": "object",
      "required": [
        "ok",
        "contract_version",
        "command",
        "records",
        "has_more",
        "next_cursor",
        "limit"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "contract_version": {
          "const": "spine.notification-rendering-disclosures.v2"
        },
        "command": {
          "const": "notification_rendering_disclosure.list"
        },
        "records": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/authorizationRecord"
          }
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "dry_run": {
          "const": true
        },
        "limit": {
          "type": "string",
          "pattern": "^([1-9]|[1-9][0-9]|100)(?![\\s\\S])"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "has_more": {
                "const": false
              }
            },
            "required": [
              "has_more"
            ]
          },
          "then": {
            "properties": {
              "next_cursor": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "next_cursor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        }
      ]
    }
  }
}
