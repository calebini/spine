{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/notification-profile-commands-v2.schema.json",
  "title": "Spine notification-profile-commands-v2 (specified, not implemented)",
  "$defs": {
    "writeIdentity": {
      "type": "object",
      "required": [
        "command_id",
        "actor_subject_id",
        "action_timestamp_utc"
      ],
      "properties": {
        "command_id": {
          "$ref": "notification-types.schema.json#/$defs/id"
        },
        "actor_subject_id": {
          "$ref": "notification-types.schema.json#/$defs/id"
        },
        "action_timestamp_utc": {
          "$ref": "notification-types.schema.json#/$defs/utcTimestamp"
        }
      }
    },
    "profileCreate": {
      "allOf": [
        {
          "$ref": "#/$defs/writeIdentity"
        },
        {
          "type": "object",
          "required": [
            "contract_version",
            "owner",
            "profile_key",
            "display_name",
            "description",
            "revision"
          ],
          "properties": {
            "contract_version": {
              "const": "spine.notification-profiles.v2"
            },
            "owner": {
              "$ref": "notification-profile-types-v2.schema.json#/$defs/owner"
            },
            "profile_key": {
              "$ref": "notification-profile-types-v2.schema.json#/$defs/key"
            },
            "display_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "description": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ]
            },
            "revision": {
              "$ref": "notification-profile-types-v2.schema.json#/$defs/profileRevision"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "profileRevise": {
      "allOf": [
        {
          "$ref": "#/$defs/writeIdentity"
        },
        {
          "type": "object",
          "required": [
            "contract_version",
            "notification_profile_id",
            "expected_current_revision_id",
            "revision"
          ],
          "properties": {
            "contract_version": {
              "const": "spine.notification-profiles.v2"
            },
            "notification_profile_id": {
              "$ref": "notification-types.schema.json#/$defs/id"
            },
            "expected_current_revision_id": {
              "$ref": "notification-types.schema.json#/$defs/id"
            },
            "revision": {
              "$ref": "notification-profile-types-v2.schema.json#/$defs/profileRevision"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "profileShow": {
      "type": "object",
      "required": [
        "contract_version",
        "notification_profile_id"
      ],
      "properties": {
        "contract_version": {
          "const": "spine.notification-profiles.v2"
        },
        "notification_profile_id": {
          "$ref": "notification-types.schema.json#/$defs/id"
        },
        "notification_profile_revision_id": {
          "$ref": "notification-types.schema.json#/$defs/id"
        }
      },
      "additionalProperties": false
    },
    "profileList": {
      "type": "object",
      "required": [
        "contract_version",
        "owner",
        "limit"
      ],
      "properties": {
        "contract_version": {
          "const": "spine.notification-profiles.v2"
        },
        "owner": {
          "$ref": "notification-profile-types-v2.schema.json#/$defs/owner"
        },
        "status": {
          "enum": [
            "active",
            "retired"
          ]
        },
        "cursor": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "type": "string",
          "pattern": "^([1-9]|[1-9][0-9]|[1-4][0-9]{2}|500)(?![\\s\\S])"
        }
      },
      "additionalProperties": false
    }
  }
}
