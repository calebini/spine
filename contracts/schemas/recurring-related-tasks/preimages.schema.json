            "not": {
              "required": [
                "recipient_group_id"
              ]
            }
          },
          "else": {
            "required": [
              "recipient_group_id"
            ],
            "not": {
              "required": [
                "recipient_subject_id"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "disabled"
              }
            }
          },
          "then": {
            "required": [
              "disabled_at_utc"
            ]
          },
          "else": {
            "not": {
