{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/recurring-related-tasks/list-request.schema.json",
  "title": "Draft recurring-task list request",
  "$comment": "Source only. Command identifier is external dispatch, not a request field. Dry run is an execution option. Exact semantic validation/precedence and byte caps remain required.",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "spine.recurring-related-tasks.v1"
    },
    "owner": {
      "$ref": "https://cortext.local/spine/contracts/schemas/recurring-related-tasks/types.schema.json#/$defs/owner"
    },
    "source_item_id": {
      "$ref": "https://cortext.local/spine/contracts/schemas/recurring-related-tasks/types.schema.json#/$defs/id"
    },
    "status": {
      "enum": [
        "active",
        "retired",
        "all"
      ],
      "default": "active"
    },
    "limit": {
      "$ref": "https://cortext.local/spine/contracts/schemas/recurring-related-tasks/types.schema.json#/$defs/positive",
      "pattern": "^(?:[1-9]|[1-9][0-9]|1[0-9]{2}|200)(?![\\s\\S])",
      "default": "50"
    },
    "cursor": {
      "$ref": "https://cortext.local/spine/contracts/schemas/recurring-related-tasks/types.schema.json#/$defs/cursor"
    }
  },
  "required": [
    "contract_version"
  ],
  "additionalProperties": false
}
