{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/trusted-web-read-occurrences-response.schema.json",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "spine.trusted-web-api.v2"
    },
    "ok": {
      "const": true
    },
    "identity_basis": {
      "const": "self_selected"
    },
    "account_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "selection_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "account_revision": {
      "$ref": "trusted-web-read-types.schema.json#/$defs/version"
    },
    "subject_revision": {
      "$ref": "trusted-web-read-types.schema.json#/$defs/version"
    },
    "account_subject_binding_revision": {
      "$ref": "trusted-web-read-types.schema.json#/$defs/version"
    },
    "access_epoch": {
      "$ref": "trusted-web-read-types.schema.json#/$defs/version"
    },
    "result_contract": {
      "const": "spine.trusted-web-occurrences.v1"
    },
    "result": {
      "type": "object",
      "properties": {
        "activity": {
          "$ref": "trusted-web-read-types.schema.json#/$defs/core"
        },
        "range": {
          "$ref": "trusted-web-read-types.schema.json#/$defs/range"
        },
        "coverage": {
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "occurrences": {
          "type": "array",
          "items": {
            "$ref": "trusted-web-read-types.schema.json#/$defs/occurrence"
          },
          "maxItems": 100
        },
        "limit": {
          "$ref": "trusted-web-read-types.schema.json#/$defs/limit"
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "oneOf": [
            {
              "$ref": "trusted-web-read-types.schema.json#/$defs/cursor"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "activity",
        "range",
        "coverage",
        "occurrences",
        "limit",
        "has_more",
        "next_cursor"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "has_more": {
                "const": true
              }
            },
            "required": [
              "has_more"
            ]
          },
          "then": {
            "properties": {
              "next_cursor": {
                "$ref": "trusted-web-read-types.schema.json#/$defs/cursor"
              }
            }
          },
          "else": {
            "properties": {
              "next_cursor": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "activity": {
                "properties": {
                  "time": {
                    "properties": {
                      "availability": {
                        "const": "unavailable"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "coverage": {
                "const": "incomplete"
              },
              "occurrences": {
                "maxItems": 0
              },
              "has_more": {
                "const": false
              },
              "next_cursor": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "coverage": {
                "const": "complete"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "activity": {
                "properties": {
                  "time": {
                    "properties": {
                      "availability": {
                        "const": "not_scheduled"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "occurrences": {
                "maxItems": 0
              },
              "has_more": {
                "const": false
              },
              "next_cursor": {
                "type": "null"
              }
            }
          }
        },
        {
          "properties": {
            "activity": {
              "properties": {
                "recurrence": {
                  "$ref": "trusted-web-read-types.schema.json#/$defs/recurrence"
                },
                "time": {
                  "properties": {
                    "availability": {
                      "enum": [
                        "available",
                        "unavailable"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "contract_version",
    "ok",
    "identity_basis",
    "account_id",
    "subject_id",
    "selection_id",
    "account_revision",
    "subject_revision",
    "account_subject_binding_revision",
    "access_epoch",
    "result_contract",
    "result"
  ],
  "additionalProperties": false
}
