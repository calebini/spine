{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/schedule-countdown-builder-request.schema.json",
  "title": "Spine Relative Event Countdown Builder Request v1",
  "type": "object",
  "required": [
    "contract_version", "command_id", "actor_subject_id", "reference_time_utc", "title", "timezone",
    "timezone_database_version", "event_delay_seconds", "reminder_interval_seconds", "delivery"
  ],
  "properties": {
    "contract_version": { "const": "spine.schedule-countdown-builder.v1" },
    "command_id": { "$ref": "notification-types.schema.json#/$defs/id" },
    "actor_subject_id": { "$ref": "notification-types.schema.json#/$defs/id" },
    "reference_time_utc": { "$ref": "notification-types.schema.json#/$defs/utcTimestamp" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "source_ref": { "type": "string" },
    "event_detail": { "$ref": "schedule-create-request.schema.json#/$defs/eventDetail" },
    "primary_location": { "$ref": "schedule-primary-location-types.schema.json#/$defs/authoring" },
    "timezone": { "type": "string", "minLength": 1 },
    "timezone_database_version": { "$ref": "schedule-create-request.schema.json#/$defs/timezoneDatabaseVersionDirective" },
    "event_delay_seconds": { "$ref": "notification-types.schema.json#/$defs/decimalPositive" },
    "reminder_start_before_seconds": { "$ref": "notification-types.schema.json#/$defs/decimalPositive" },
    "reminder_interval_seconds": { "$ref": "notification-types.schema.json#/$defs/decimalPositive" },
    "policy_key": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "materialization_limit": {
      "type": "string",
      "pattern": "^([1-9]|[1-9][0-9]|[1-9][0-9]{2}|1000)$"
    },
    "delivery": { "$ref": "schedule-create-request.schema.json#/$defs/delivery" }
  },
  "additionalProperties": false
}
