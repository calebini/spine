{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/runtime-dependency-failure.schema.json",
  "title": "Spine Worker Runtime Dependency Failure v1",
  "type": "object",
  "required": [
    "event",
    "reason",
    "dependency",
    "compatibility_contract",
    "required_package_version",
    "installed_package_version",
    "required_capability_id",
    "installed_capability_id",
    "required_descriptor_sha256",
    "installed_descriptor_sha256",
    "mismatch_fields"
  ],
  "properties": {
    "event": { "const": "ledger_runtime_preflight_failed" },
    "reason": { "const": "runtime_dependency_mismatch" },
    "dependency": { "const": "tickerd" },
    "compatibility_contract": { "const": "spine.tickerd-compatibility.v1" },
    "required_package_version": { "const": "0.2.0" },
    "installed_package_version": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "required_capability_id": { "const": "tickerd.runtime-capabilities.v1" },
    "installed_capability_id": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "required_descriptor_sha256": {
      "const": "215f9aa6b54e6c0e6186796a55d78e1c5a270adc9b3ccefb433df5a3bb87b58b"
    },
    "installed_descriptor_sha256": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        { "type": "null" }
      ]
    },
    "mismatch_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "x-spine-order": "lexicographic",
      "items": {
        "enum": [
          "capability_id",
          "descriptor_sha256",
          "descriptor_shape",
          "package_import",
          "package_version",
          "public_api",
          "required_claims"
        ]
      }
    }
  },
  "additionalProperties": false
}
