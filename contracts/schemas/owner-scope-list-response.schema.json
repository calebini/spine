{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/owner-scope-list-response.schema.json",
  "title": "Spine Owner-Scope List Response v1",
  "type": "object",
  "required": [
    "ok",
    "command",
    "response_contract",
    "owner_kinds",
    "statuses",
    "subject_kinds",
    "group_kinds",
    "limit",
    "query_hash",
    "source_generation",
    "entries",
    "has_more",
    "next_cursor"
  ],
  "properties": {
    "ok": { "const": true },
    "command": { "const": "owner_scope.list" },
    "response_contract": { "const": "spine.owner-scope-list-response.v1" },
    "owner_kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["system", "subject", "subject_group"] }
    },
    "statuses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["active", "inactive"] }
    },
    "subject_kinds": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["person", "agent"] }
    },
    "group_kinds": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": ["household", "project", "team", "transport_group"]
      }
    },
    "limit": {
      "type": "string",
      "pattern": "^([1-9]|[1-9][0-9]|[1-4][0-9]{2}|500)$"
    },
    "query_hash": { "$ref": "notification-types.schema.json#/$defs/sha256" },
    "source_generation": {
      "$ref": "notification-types.schema.json#/$defs/decimalNonNegative"
    },
    "entries": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/entry" }
    },
    "has_more": { "type": "boolean" },
    "next_cursor": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "has_more": { "const": true } },
        "required": ["has_more"]
      },
      "then": {
        "properties": {
          "next_cursor": { "type": "string", "minLength": 1 }
        }
      },
      "else": { "properties": { "next_cursor": { "type": "null" } } }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "owner": {
      "oneOf": [
        {
          "type": "object",
          "required": ["owner_kind"],
          "properties": { "owner_kind": { "const": "system" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["owner_kind", "owner_subject_id"],
          "properties": {
            "owner_kind": { "const": "subject" },
            "owner_subject_id": {
              "$ref": "notification-types.schema.json#/$defs/id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["owner_kind", "owner_group_id"],
          "properties": {
            "owner_kind": { "const": "subject_group" },
            "owner_group_id": {
              "$ref": "notification-types.schema.json#/$defs/id"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "entry": {
      "type": "object",
      "required": [
        "owner_scope_key",
        "owner",
        "identity_kind",
        "display_name",
        "status",
        "source"
      ],
      "properties": {
        "owner_scope_key": { "type": "string", "minLength": 1 },
        "owner": { "$ref": "#/$defs/owner" },
        "identity_kind": {
          "enum": [
            "system",
            "person",
            "agent",
            "household",
            "project",
            "team",
            "transport_group"
          ]
        },
        "display_name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "inactive"] },
        "source": {
          "enum": ["derived_system", "subjects", "subject_groups"]
        }
      },
      "additionalProperties": false
    }
  }
}
