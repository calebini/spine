{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/notification-profile-types.schema.json",
  "title": "Spine Notification Profile Types v1",
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "owner": {
      "oneOf": [
        {
          "type": "object",
          "required": ["owner_kind"],
          "properties": { "owner_kind": { "const": "system" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["owner_kind", "owner_subject_id"],
          "properties": {
            "owner_kind": { "const": "subject" },
            "owner_subject_id": { "$ref": "notification-types.schema.json#/$defs/id" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["owner_kind", "owner_group_id"],
          "properties": {
            "owner_kind": { "const": "subject_group" },
            "owner_group_id": { "$ref": "notification-types.schema.json#/$defs/id" }
          },
          "additionalProperties": false
        }
      ]
    },
    "itemTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["event", "task"] }
    },
    "archetypeRevision": {
      "type": "object",
      "required": ["display_name", "description", "compatible_item_types"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 2000 },
            { "type": "null" }
          ]
        },
        "compatible_item_types": { "$ref": "#/$defs/itemTypes" }
      },
      "additionalProperties": false
    },
    "template": {
      "type": "object",
      "required": ["template_key", "schedule", "late_handling"],
      "properties": {
        "template_key": { "$ref": "#/$defs/key" },
        "schedule": { "$ref": "notification-types.schema.json#/$defs/schedule" },
        "late_handling": { "$ref": "notification-types.schema.json#/$defs/lateHandling" }
      },
      "additionalProperties": false
    },
    "profileRevision": {
      "type": "object",
      "required": ["compatible_item_types", "templates"],
      "properties": {
        "compatible_item_types": { "$ref": "#/$defs/itemTypes" },
        "templates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/template" }
        }
      },
      "additionalProperties": false
    },
    "archetypeSelection": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "item_archetype_id",
            "revision_resolution",
            "selection_source"
          ],
          "properties": {
            "item_archetype_id": { "$ref": "notification-types.schema.json#/$defs/id" },
            "revision_resolution": { "const": "current" },
            "selection_source": {
              "enum": ["operator_explicit", "agent_selected", "imported"]
            },
            "source_ref": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "item_archetype_id",
            "revision_resolution",
            "item_archetype_revision_id",
            "selection_source"
          ],
          "properties": {
            "item_archetype_id": { "$ref": "notification-types.schema.json#/$defs/id" },
            "revision_resolution": { "const": "exact" },
            "item_archetype_revision_id": { "$ref": "notification-types.schema.json#/$defs/id" },
            "selection_source": {
              "enum": ["operator_explicit", "agent_selected", "imported"]
            },
            "source_ref": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "replacement": {
      "type": "object",
      "required": ["template_key", "schedule", "late_handling"],
      "properties": {
        "template_key": { "$ref": "#/$defs/key" },
        "schedule": { "$ref": "notification-types.schema.json#/$defs/schedule" },
        "late_handling": { "$ref": "notification-types.schema.json#/$defs/lateHandling" }
      },
      "additionalProperties": false
    },
    "customAddition": {
      "type": "object",
      "required": ["policy_key", "schedule", "late_handling"],
      "properties": {
        "policy_key": { "$ref": "#/$defs/key" },
        "schedule": { "$ref": "notification-types.schema.json#/$defs/schedule" },
        "late_handling": { "$ref": "notification-types.schema.json#/$defs/lateHandling" }
      },
      "additionalProperties": false
    },
    "overlays": {
      "type": "object",
      "properties": {
        "suppress_template_keys": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        },
        "replacements": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/replacement" }
        },
        "custom_additions": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/customAddition" }
        }
      }
    },
    "createPlan": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode", "custom_additions"],
          "properties": {
            "mode": { "const": "none" },
            "custom_additions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": { "$ref": "#/$defs/customAddition" }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "notification_profile_id", "revision_resolution"],
          "properties": {
            "mode": { "const": "explicit" },
            "notification_profile_id": { "$ref": "notification-types.schema.json#/$defs/id" },
            "revision_resolution": { "enum": ["current", "exact"] },
            "notification_profile_revision_id": { "$ref": "notification-types.schema.json#/$defs/id" },
            "suppress_template_keys": { "$ref": "#/$defs/overlays/properties/suppress_template_keys" },
            "replacements": { "$ref": "#/$defs/overlays/properties/replacements" },
            "custom_additions": { "$ref": "#/$defs/overlays/properties/custom_additions" }
          },
          "allOf": [
            {
              "if": {
                "properties": { "revision_resolution": { "const": "exact" } },
                "required": ["revision_resolution"]
              },
              "then": { "required": ["notification_profile_revision_id"] },
              "else": { "not": { "required": ["notification_profile_revision_id"] } }
            }
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "scope_chain", "on_no_match"],
          "properties": {
            "mode": { "const": "archetype_default" },
            "scope_chain": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/owner" }
            },
            "on_no_match": { "enum": ["fail", "use_custom_only"] },
            "suppress_template_keys": { "$ref": "#/$defs/overlays/properties/suppress_template_keys" },
            "replacements": { "$ref": "#/$defs/overlays/properties/replacements" },
            "custom_additions": { "$ref": "#/$defs/overlays/properties/custom_additions" }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
