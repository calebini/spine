{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/schedule-update-response.schema.json",
  "title": "Spine Atomic Schedule Update Response v1",
  "type": "object",
  "required": [
    "ok", "command", "response_contract", "effect", "command_id", "command_receipt_id",
    "item_id", "item_type", "target_version", "current_version", "truth_changed", "work_changed",
    "changed_dimensions", "scheduled_time", "policies", "disabled_notification_intent_ids",
    "work_reconciliation", "materialization", "phases", "receipt"
  ],
  "properties": {
    "ok": { "const": true },
    "command": { "const": "schedule.update" },
    "response_contract": { "const": "spine.schedule-update-response.v1" },
    "effect": {
      "enum": [
        "schedule_updated_and_reconciled", "schedule_updated", "schedule_reconciled",
        "schedule_update_noop", "schedule_update_replay"
      ]
    },
    "command_id": { "$ref": "notification-types.schema.json#/$defs/id" },
    "command_receipt_id": { "$ref": "notification-types.schema.json#/$defs/id" },
    "audit_id": { "$ref": "notification-types.schema.json#/$defs/id" },
    "item_id": { "$ref": "notification-types.schema.json#/$defs/id" },
    "item_type": { "enum": ["event", "task"] },
    "target_version": { "$ref": "notification-types.schema.json#/$defs/decimalPositive" },
    "current_version": { "$ref": "notification-types.schema.json#/$defs/decimalPositive" },
    "truth_changed": { "type": "boolean" },
    "work_changed": { "type": "boolean" },
    "changed_dimensions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["item", "scheduled_time", "recurrence", "delivery", "reminders"] }
    },
    "scheduled_time": { "$ref": "schedule-create-response.schema.json#/$defs/resolvedSchedule" },
    "recurrence": { "$ref": "#/$defs/recurrenceSummary" },
    "policies": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "schedule-operations-types.schema.json#/$defs/policyResult" }
    },
    "disabled_notification_intent_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "notification-types.schema.json#/$defs/id" }
    },
    "work_reconciliation": { "$ref": "schedule-operations-types.schema.json#/$defs/workReconciliation" },
    "materialization": {
      "oneOf": [
        { "$ref": "schedule-create-response.schema.json#/$defs/materializationNone" },
        { "$ref": "schedule-create-response.schema.json#/$defs/materializationBounded" }
      ]
    },
    "phases": { "$ref": "#/$defs/phases" },
    "receipt": {
      "allOf": [
        { "$ref": "schedule-operations-types.schema.json#/$defs/receiptSummary" },
        {
          "properties": {
            "receipt_contract": { "const": "spine.schedule-update-receipt.v1" },
            "effect": {
              "enum": [
                "schedule_updated_and_reconciled", "schedule_updated",
                "schedule_reconciled", "schedule_update_noop"
              ]
            }
          }
        }
      ]
    },
    "dry_run": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "receipt": {
            "properties": { "effect": { "const": "schedule_update_noop" } },
            "required": ["effect"]
          }
        },
        "required": ["receipt"]
      },
      "then": { "not": { "required": ["audit_id"] } },
      "else": { "required": ["audit_id"] }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "recurrenceSummary": {
      "type": "object",
      "required": [
        "recurrence_set_id", "recurrence_revision_id", "revision_number",
        "normalized_recurrence_set_hash", "diagnostics"
      ],
      "properties": {
        "recurrence_set_id": { "$ref": "notification-types.schema.json#/$defs/id" },
        "recurrence_revision_id": { "$ref": "notification-types.schema.json#/$defs/id" },
        "revision_number": { "$ref": "notification-types.schema.json#/$defs/decimalPositive" },
        "normalized_recurrence_set_hash": { "$ref": "notification-types.schema.json#/$defs/sha256" },
        "diagnostics": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    },
    "phases": {
      "type": "object",
      "required": ["truth", "provenance", "opportunities", "work", "delivery"],
      "properties": {
        "truth": { "enum": ["updated", "unchanged"] },
        "provenance": { "enum": ["regenerated", "retained", "not_applicable"] },
        "opportunities": { "enum": ["expanded", "not_requested"] },
        "work": { "enum": ["none", "reconciled", "materialized", "reconciled_and_materialized"] },
        "delivery": { "const": "not_attempted" }
      },
      "additionalProperties": false
    }
  }
}
