{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/trusted-web-read-error.schema.json",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "spine.trusted-web-api.v2"
    },
    "ok": {
      "const": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "invalid_request",
            "identity_unavailable",
            "operation_unavailable",
            "resource_unavailable",
            "access_changed",
            "version_changed",
            "capacity_exceeded",
            "admission_unavailable",
            "domain_failure"
          ]
        },
        "message": {
          "const": "Read unavailable."
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "selection_id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "contract_version",
    "ok",
    "error",
    "correlation_id",
    "selection_id"
  ],
  "additionalProperties": false
}
