{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/spine/contracts/schemas/trusted-web-command-payloads.schema.json",
  "$defs": {
    "taskCompleteRequest": {
      "type": "object",
      "required": [
        "command_id",
        "actor_subject_id",
        "item_id",
        "target_version",
        "completed_at_utc"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "actor_subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "target_version": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "completed_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "completion_state": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "taskCompleteResponse": {
      "type": "object",
      "required": [
        "ok",
        "command",
        "completed",
        "item_id",
        "item_type",
        "target_version",
        "version",
        "current_version",
        "updated_at_utc",
        "audit_id",
        "command_receipt_id"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "command": {
          "const": "task.complete"
        },
        "completed": {
          "type": "boolean"
        },
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "item_type": {
          "const": "task"
        },
        "target_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "current_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "updated_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "audit_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "command_receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      },
      "additionalProperties": false
    },
    "itemOccurrencesRequest": {
      "type": "object",
      "required": [
        "item_id",
        "range_start",
        "range_end"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "range_start": {
          "$ref": "recurrence-types.schema.json#/$defs/scheduledFact"
        },
        "range_end": {
          "$ref": "recurrence-types.schema.json#/$defs/scheduledFact"
        },
        "limit": {
          "type": "string",
          "pattern": "^([1-9]|[1-9][0-9]|[1-9][0-9]{2}|1000)$"
        },
        "cursor": {
          "type": "string",
          "minLength": 1
        },
        "range_basis": {
          "enum": [
            "original_schedule",
            "expressed_time"
          ]
        },
        "include_diagnostics": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
