{
  "contract_version": "spine.facet-integration.v1",
  "status": "draft_not_implemented",
  "normative_source": "specs/archetype-facets.md",
  "permission_resolvers": {
    "facet_schema.create": [
      "owner.catalog_admin"
    ],
    "facet_schema.publish": [
      "schema.catalog_admin"
    ],
    "facet_schema.retire": [
      "schema.catalog_admin"
    ],
    "facet_schema.show": [
      "schema.catalog_read"
    ],
    "facet_schema.list": [
      "owner.authorized_catalog_candidates"
    ],
    "item_archetype.facet_binding.set": [
      "archetype.catalog_admin",
      "schema.catalog_admin",
      "same_catalog_owner"
    ],
    "item_archetype.facet_binding.remove": [
      "archetype.catalog_admin"
    ],
    "item_archetype.facet_binding.list": [
      "archetype.catalog_read",
      "returned_schemas.catalog_read"
    ],
    "item.facets.update": [
      "item.edit",
      "fresh_sets.archetype_catalog_use",
      "fresh_sets.schema_catalog_use",
      "fresh_sets.reference_authority"
    ],
    "item.facets.show": [
      "item.read_current_authority",
      "returned_references.read"
    ],
    "item.facets.query": [
      "schema.catalog_read",
      "owner.authorized_item_candidates",
      "reference_predicate.read"
    ]
  },
  "item_set_compatibility": {
    "applies_to": "every_fresh_set_including_same_value_noop",
    "required_membership": [
      "pinned_assigned_archetype_revision.compatible_item_types",
      "pinned_facet_schema_revision.compatible_item_types"
    ],
    "failure": {"code": "wrong_item_type", "field": "item_id", "exit": 2, "web": "domain_failure", "http": 422},
    "skip_for": ["remove", "unchanged_copy_forward", "compatible_receipt_replay"]
  },
  "replay_permission_resolvers": {
    "facet_schema.create": ["receipt.schema.catalog_read"],
    "facet_schema.publish": ["receipt.schema.catalog_read"],
    "facet_schema.retire": ["receipt.schema.catalog_read"],
    "item_archetype.facet_binding.set": ["receipt.archetype.catalog_read", "receipt.schema.catalog_read"],
    "item_archetype.facet_binding.remove": ["receipt.archetype.catalog_read"],
    "item.facets.update": ["receipt.item.read_current_authority"]
  },
  "replay": {
    "permission_enforced_identity": "same_initiating_account_and_subject",
    "applies_to": ["changed_receipt", "noop_receipt"],
    "create_outcomes": ["changed_receipt"],
    "precedence": ["shape_bounds", "identity_operation_admission", "private_receipt_lookup", "initiating_identity", "receipt_disclosure_authority", "semantic_compatibility", "release_authority_recheck", "replay_projection"],
    "receipt_absent": "fresh_permission_resolvers_then_domain_validation",
    "foreign_receipt": "command_id_unavailable",
    "deferred_protected_foreign_receipt": "request_id_unavailable",
    "hidden_receipt_resource": "resource_unavailable",
    "release_authority_lost": "access_changed",
    "semantic_mismatch": "semantic_conflict",
    "fresh_write_permissions_required": false,
    "active_catalog_or_binding_required": false,
    "item_update_reference_resolution": "none_receipt_has_no_facet_values_or_reference_ids",
    "trusted_local": "full_scope_existing_normalized_request_and_actor_compatibility",
    "durable_writes": false
  },
  "reference_visibility": {
    "trusted_local": "existing; subject must be active on set",
    "permission_enforced": {
      "subject": "selected_subject_only",
      "location": "deny_until_family_owned_sharing_contract"
    }
  },
  "cursor": {
    "contract_version": "spine.facet-cursor.v1",
    "payload_schema": "contracts/schemas/archetype-facet-cursor.schema.json",
    "prefix": "fc1",
    "mac_domain": "spine.facet-cursor.v1",
    "mac_separator": "NUL",
    "algorithm": "HMAC-SHA256",
    "encoding": "unpadded canonical base64url",
    "max_token_bytes": 4096,
    "ttl_seconds": 900,
    "min_secret_bytes": 32,
    "max_candidates": 100,
    "max_resolved_resources": 100,
    "max_access_proof_rows": 100,
    "query_domain": "spine.facet-query.v1",
    "context_domain": "spine.facet-cursor-context.v1",
    "access_domain": "spine.facet-cursor-access.v1",
    "source_domain": "spine.facet-cursor-source.v1",
    "orders": {
      "facet_schema.list": "facet_schema_id",
      "item_archetype.facet_binding.list": "facet_key",
      "item.facets.query": "item_id"
    },
    "durable_read_writes": false,
    "release_revalidation": {
      "max_snapshot_constructions": 1,
      "automatic_retries": 0,
      "reset_budget": false,
      "precedence": ["current_authority", "capacity", "source_comparison"],
      "first_page_source_change": "first_page_source_changed",
      "continuation_source_change": "stale_cursor",
      "first_page_access_transition": "first_page_access_changed",
      "failure_result_or_cursor": false
    }
  },
  "work": {
    "contract_version": "spine.facet-notification-continuity.v1",
    "current_policy_key": [
      "item_id",
      "notification_intent_id"
    ],
    "comparison_policy_fields": [
      "notification_intent_id",
      "intent_created_item_version",
      "intent_created_by_command_id",
      "status",
      "recipient_kind",
      "recipient_subject_id",
      "recipient_group_id",
      "channel",
      "delivery_target_id",
      "target",
      "normalized_notification_schedule_hash",
      "late_handling"
    ],
    "row_mutations": [],
    "materialize": false,
    "regenerate_provenance": false,
    "new_attempts": false,
    "source_event_facet_edit": "dependent follow_source binding becomes stale by existing source-version rules; reconcile separately",
    "target_task_facet_edit": "preserve unchanged source and due anchor meaning; do not revise binding",
    "comparison_failure": "environment_failure",
    "states": {
      "eligible_unattempted": "retain",
      "leased_or_in_progress": "preserve_lease_and_recheck_before_attempt",
      "eligible_retry": "preserve_retry_and_recheck",
      "terminal": "preserve_history",
      "independently_stale": "leave_to_existing_stale_handling",
      "absent": "do_not_materialize"
    },
    "reconciliation_performed": "fresh changed and (current policies exist or notification_reminder work exists); equivalence proof only"
  },
  "adapter_errors": {
    "invalid_request": {
      "cli": "invalid_request",
      "exit": 2,
      "web": "invalid_request",
      "http": 400
    },
    "stale_cursor": {
      "cli": "stale_cursor",
      "exit": 6,
      "web": "access_changed",
      "http": 409
    },
    "first_page_source_changed": {
      "cli": "environment_failure",
      "exit": 7,
      "web": "access_changed",
      "http": 409
    },
    "first_page_access_changed": {
      "cli": "environment_failure",
      "exit": 7,
      "web": "access_changed",
      "http": 409
    },
    "capacity": {
      "cli": "environment_failure",
      "exit": 7,
      "web": "capacity_exceeded",
      "http": 429
    },
    "missing_cursor_context": {
      "cli": "environment_failure",
      "exit": 7,
      "web": "admission_unavailable",
      "http": 503
    },
    "hidden_reference": {
      "cli": "facet_reference_unavailable",
      "exit": 4,
      "web": "resource_unavailable",
      "http": 404
    }
  },
  "runtime_proofs_required": [
    "database_permission_resolution_and_no_disclosure",
    "authenticated_pagination_concurrent_revocation_and_source_change",
    "notification_multi_copy_attempt_start",
    "recurring_and_follow_source_continuity",
    "migration_rollback_indexes_and_all_version_writers"
  ]
}
