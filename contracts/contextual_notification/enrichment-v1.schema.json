{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spine:notification-enrichment:v1",
  "$defs": {
    "config": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "spine.notification-enrichment-config.v1"
        },
        "synthetic_only": {
          "const": false
        },
        "work_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "actor_subject_id": {
          "type": "string",
          "minLength": 1
        },
        "opted_in_item_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 1
        },
        "permit_ordinary_text": {
          "const": true
        },
        "facet_fields": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "definition_revision": {
          "type": "string",
          "minLength": 1
        },
        "disclosure_revision": {
          "type": "string",
          "minLength": 1
        },
        "retention_reference": {
          "type": "string",
          "minLength": 1
        },
        "approved_context_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lead_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "allowed_tools": {
          "type": "array",
          "maxItems": 0
        },
        "provider_configuration_json": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "contract",
        "synthetic_only",
        "work_instance_id",
        "actor_subject_id",
        "opted_in_item_ids",
        "permit_ordinary_text",
        "facet_fields",
        "definition_revision",
        "disclosure_revision",
        "retention_reference",
        "approved_context_sha256",
        "lead_seconds",
        "allowed_tools"
      ],
      "additionalProperties": false
    },
    "choice": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "spine.notification-enrichment-choice.v1"
        },
        "work_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "opportunity_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "ordinary",
            "enriched"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "request_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_fingerprint": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "capture_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "addendum": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        }
      },
      "required": [
        "contract",
        "work_instance_id",
        "opportunity_id",
        "kind",
        "reason",
        "request_sha256",
        "source_fingerprint",
        "capture_sha256",
        "addendum"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "enriched"
              }
            }
          },
          "then": {
            "properties": {
              "addendum": {
                "type": "string",
                "minLength": 1
              },
              "request_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "source_fingerprint": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "capture_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "else": {
            "properties": {
              "addendum": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "outbound": {
      "type": "object",
      "properties": {
        "delivery_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "causation_id": {
          "type": "string",
          "minLength": 1
        },
        "channel_hint": {
          "type": "string",
          "minLength": 1
        },
        "target_ref": {
          "type": "string",
          "minLength": 1
        },
        "body_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "dedupe_key": {
          "type": "string",
          "minLength": 1
        },
        "provider_idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "created_at_utc": {
          "type": "string",
          "minLength": 1
        },
        "notification_rendering_id": {
          "type": "string",
          "minLength": 1
        },
        "ordinary_rendered_content_hash": {
          "type": "string",
          "minLength": 1
        },
        "enrichment_selection": {
          "type": "string",
          "minLength": 1
        },
        "payload_version": {
          "const": "spine.openclaw.outbound.v3"
        },
        "enriched_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "delivery_id",
        "attempt_id",
        "trace_id",
        "causation_id",
        "channel_hint",
        "target_ref",
        "body_text",
        "dedupe_key",
        "provider_idempotency_key",
        "created_at_utc",
        "notification_rendering_id",
        "ordinary_rendered_content_hash",
        "enrichment_selection",
        "payload_version",
        "enriched_content_sha256"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "spine.notification-enrichment-evidence.v1"
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_status": {
          "enum": [
            "started",
            "succeeded",
            "failed",
            "rejected"
          ]
        },
        "provider_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_payload_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "envelope": {
          "type": "object",
          "properties": {
            "delivery_id": {
              "type": "string",
              "minLength": 1
            },
            "attempt_id": {
              "type": "string",
              "minLength": 1
            },
            "trace_id": {
              "type": "string",
              "minLength": 1
            },
            "causation_id": {
              "type": "string",
              "minLength": 1
            },
            "channel_hint": {
              "type": "string",
              "minLength": 1
            },
            "target_ref": {
              "type": "string",
              "minLength": 1
            },
            "body_text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "dedupe_key": {
              "type": "string",
              "minLength": 1
            },
            "provider_idempotency_key": {
              "type": "string",
              "minLength": 1
            },
            "created_at_utc": {
              "type": "string",
              "minLength": 1
            },
            "notification_rendering_id": {
              "type": "string",
              "minLength": 1
            },
            "ordinary_rendered_content_hash": {
              "type": "string",
              "minLength": 1
            },
            "enrichment_selection": {
              "type": "string",
              "minLength": 1
            },
            "payload_version": {
              "const": "spine.openclaw.outbound.v3"
            },
            "enriched_content_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "delivery_id",
            "attempt_id",
            "trace_id",
            "causation_id",
            "channel_hint",
            "target_ref",
            "body_text",
            "dedupe_key",
            "provider_idempotency_key",
            "created_at_utc",
            "notification_rendering_id",
            "ordinary_rendered_content_hash",
            "enrichment_selection",
            "payload_version",
            "enriched_content_sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract",
        "attempt_id",
        "attempt_status",
        "provider_ref",
        "request_payload_hash",
        "envelope"
      ],
      "additionalProperties": false
    }
  }
}
