{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortext.local/impetus/contextual-notification-openai-v1.schema.json",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "interface": {
          "const": "contextual-notification-experiment"
        },
        "version": {
          "const": "impetus.openai.v1"
        },
        "work_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_refs": {
          "type": "object",
          "properties": {
            "ledger_instance_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "item_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "notification_opportunity_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "notification_policy_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "rendering_definition_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "experiment_definition_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "disclosure_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "item_version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "ledger_instance_id",
            "item_id",
            "notification_opportunity_id",
            "notification_policy_id",
            "rendering_definition_revision",
            "experiment_definition_revision",
            "disclosure_revision",
            "item_version"
          ],
          "additionalProperties": false
        },
        "captured_at_utc": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
        },
        "context": {
          "type": "object",
          "properties": {
            "archetype": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "event": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "starts_at_utc": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
                },
                "timezone": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "primary_location": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8192
                    }
                  },
                  "required": [
                    "label"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "title",
                "starts_at_utc",
                "timezone"
              ],
              "additionalProperties": false
            },
            "facets": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "properties": {
                  "schema_revision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "values": {
                    "type": "object"
                  }
                },
                "required": [
                  "schema_revision",
                  "values"
                ],
                "additionalProperties": false
              }
            },
            "notification": {
              "type": "object",
              "properties": {
                "eligible_at_utc": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
                },
                "seconds_before_event": {
                  "type": "integer"
                },
                "ordinary_text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                }
              },
              "required": [
                "eligible_at_utc",
                "seconds_before_event",
                "ordinary_text"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "archetype",
            "event",
            "facets",
            "notification"
          ],
          "additionalProperties": false
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "allowed_tools": {
          "const": []
        },
        "limits": {
          "type": "object",
          "properties": {
            "model_calls": {
              "const": 1
            },
            "tool_calls": {
              "const": 0
            },
            "elapsed_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "addendum_utf8_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            }
          },
          "required": [
            "model_calls",
            "tool_calls",
            "elapsed_seconds",
            "addendum_utf8_bytes"
          ],
          "additionalProperties": false
        },
        "selection_cutoff_utc": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
        },
        "request_expires_at_utc": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
        }
      },
      "required": [
        "interface",
        "version",
        "work_id",
        "source_refs",
        "captured_at_utc",
        "context",
        "objective",
        "allowed_tools",
        "limits",
        "selection_cutoff_utc",
        "request_expires_at_utc"
      ],
      "additionalProperties": false
    },
    "read": {
      "type": "object",
      "properties": {
        "interface": {
          "const": "contextual-notification-experiment"
        },
        "version": {
          "const": "impetus.openai.v1"
        },
        "ledger_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "work_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "interface",
        "version",
        "ledger_instance_id",
        "work_id",
        "request_sha256"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "interface": {
          "const": "contextual-notification-experiment"
        },
        "version": {
          "const": "impetus.openai.v1"
        },
        "ledger_instance_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "work_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "request_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "disposition": {
          "enum": [
            "new",
            "existing",
            "rejected",
            "conflict",
            "unresolved",
            "found",
            "absent",
            "unavailable"
          ]
        },
        "execution": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "admitted",
                    "running",
                    "succeeded",
                    "failed",
                    "interrupted",
                    "uncertain"
                  ]
                },
                "configuration_revision": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "prompt_revision": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "started_at_utc": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "completed_at_utc": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "calls": {
                  "type": "array",
                  "maxItems": 2,
                  "items": {
                    "type": "object",
                    "properties": {
                      "ordinal": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2
                      },
                      "operation": {
                        "enum": [
                          "openai.responses.v1",
                          "openai.responses.input_tokens.v1"
                        ]
                      },
                      "possible_entry_at_utc": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
                      },
                      "certainty": {
                        "enum": [
                          "complete",
                          "uncertain"
                        ]
                      },
                      "usage": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "unit": {
                                "const": "usd_nanodollars"
                              },
                              "amount": {
                                "type": "integer",
                                "minimum": 0
                              }
                            },
                            "required": [
                              "unit",
                              "amount"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "reserve": {
                        "type": "object",
                        "properties": {
                          "unit": {
                            "const": "usd_nanodollars"
                          },
                          "amount": {
                            "type": "integer",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "unit",
                          "amount"
                        ],
                        "additionalProperties": false
                      },
                      "completed_at_utc": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
                      },
                      "tokens": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "object",
                            "required": [
                              "input_tokens",
                              "output_tokens",
                              "total_tokens",
                              "reasoning_tokens"
                            ],
                            "additionalProperties": false,
                            "properties": {
                              "input_tokens": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "output_tokens": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "total_tokens": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "reasoning_tokens": {
                                "anyOf": [
                                  {
                                    "type": "integer",
                                    "minimum": 0
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              }
                            }
                          }
                        ]
                      },
                      "provider_response_id": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "provider_model": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "request_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "generation_request_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "count_call_ordinal": {
                        "const": 1
                      },
                      "counted_input_tokens": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4000000
                      }
                    },
                    "required": [
                      "ordinal",
                      "operation",
                      "possible_entry_at_utc",
                      "certainty",
                      "usage",
                      "reserve",
                      "tokens"
                    ],
                    "additionalProperties": false
                  },
                  "allOf": [
                    {
                      "if": {
                        "minItems": 2
                      },
                      "then": {
                        "prefixItems": [
                          {
                            "properties": {
                              "operation": {
                                "const": "openai.responses.input_tokens.v1"
                              },
                              "ordinal": {
                                "const": 1
                              }
                            }
                          },
                          {
                            "properties": {
                              "operation": {
                                "const": "openai.responses.v1"
                              },
                              "ordinal": {
                                "const": 2
                              }
                            }
                          }
                        ]
                      }
                    }
                  ]
                },
                "result": {
                  "anyOf": [
                    {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "no_addition"
                            },
                            "review_note": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 8192
                            }
                          },
                          "required": [
                            "kind",
                            "review_note"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "addendum"
                            },
                            "text": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 8192
                            },
                            "basis": {
                              "enum": [
                                "provided_context",
                                "retrieved",
                                "mixed"
                              ]
                            },
                            "sources": {
                              "type": "array",
                              "maxItems": 4,
                              "items": {
                                "type": "object",
                                "properties": {
                                  "observation_ordinal": {
                                    "type": "integer",
                                    "minimum": 1
                                  },
                                  "reference": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 256
                                  },
                                  "retrieved_at_utc": {
                                    "type": "string",
                                    "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
                                  },
                                  "valid_until_utc": {
                                    "anyOf": [
                                      {
                                        "type": "string",
                                        "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  }
                                },
                                "required": [
                                  "observation_ordinal",
                                  "reference",
                                  "retrieved_at_utc",
                                  "valid_until_utc"
                                ],
                                "additionalProperties": false
                              }
                            },
                            "review_note": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 8192
                            }
                          },
                          "required": [
                            "kind",
                            "text",
                            "basis",
                            "sources",
                            "review_note"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reason": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "observations": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "required": [
                      "kind",
                      "call_ordinal",
                      "observed_at_utc",
                      "response"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "late_response"
                      },
                      "call_ordinal": {
                        "type": "integer",
                        "enum": [
                          1,
                          2
                        ]
                      },
                      "observed_at_utc": {
                        "type": "string"
                      },
                      "response": {
                        "anyOf": [
                          {
                            "type": "object"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  }
                },
                "interface_version": {
                  "const": "impetus.openai.v1"
                },
                "live_day": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
                },
                "authorized_nanodollars": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20000000
                },
                "provider_configuration": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "model",
                    "max_output_tokens",
                    "input_token_upper_bound",
                    "input_nanodollars_per_million",
                    "output_nanodollars_per_million",
                    "qualification_reference"
                  ],
                  "properties": {
                    "model": {
                      "type": "string"
                    },
                    "max_output_tokens": {
                      "type": "integer"
                    },
                    "input_token_upper_bound": {
                      "type": "integer"
                    },
                    "input_nanodollars_per_million": {
                      "type": "integer"
                    },
                    "output_nanodollars_per_million": {
                      "type": "integer"
                    },
                    "qualification_reference": {
                      "type": "string"
                    },
                    "model_binding": {
                      "enum": [
                        "dated_snapshot",
                        "documented_alias"
                      ]
                    },
                    "reasoning_effort": {
                      "enum": [
                        "none",
                        "low",
                        "medium",
                        "high",
                        "xhigh",
                        "max"
                      ]
                    },
                    "token_counting": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "charge_bound_nanodollars"
                      ],
                      "properties": {
                        "charge_bound_nanodollars": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 20000000
                        }
                      }
                    }
                  }
                }
              },
              "required": [
                "status",
                "configuration_revision",
                "prompt_revision",
                "started_at_utc",
                "completed_at_utc",
                "calls",
                "result",
                "reason",
                "observations",
                "interface_version",
                "live_day",
                "authorized_nanodollars",
                "provider_configuration"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "$comment": "A late observation for call 1 requires that existing generation, never a count call.",
                  "if": {
                    "properties": {
                      "observations": {
                        "contains": {
                          "properties": {
                            "call_ordinal": {
                              "const": 1
                            }
                          },
                          "required": [
                            "call_ordinal"
                          ]
                        }
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "calls": {
                        "minItems": 1,
                        "contains": {
                          "properties": {
                            "ordinal": {
                              "const": 1
                            },
                            "operation": {
                              "const": "openai.responses.v1"
                            }
                          },
                          "required": [
                            "ordinal",
                            "operation"
                          ]
                        }
                      }
                    }
                  }
                },
                {
                  "$comment": "A late observation for call 2 requires that existing generation, never a count call.",
                  "if": {
                    "properties": {
                      "observations": {
                        "contains": {
                          "properties": {
                            "call_ordinal": {
                              "const": 2
                            }
                          },
                          "required": [
                            "call_ordinal"
                          ]
                        }
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "calls": {
                        "minItems": 2,
                        "contains": {
                          "properties": {
                            "ordinal": {
                              "const": 2
                            },
                            "operation": {
                              "const": "openai.responses.v1"
                            }
                          },
                          "required": [
                            "ordinal",
                            "operation"
                          ]
                        }
                      }
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "interface",
        "version",
        "ledger_instance_id",
        "work_id",
        "request_sha256",
        "disposition",
        "execution",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
