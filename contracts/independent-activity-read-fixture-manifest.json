      "status": "backend_verified",
      "setup": "Same root with inaccessible follower",
      "action": "Repeat reads after hidden follower mutation",
      "oracle": "Same disclosed projection, section coverage, cursors and diagnostics",
      "fixture_ids": [
        "response_authorized_empty_context"
      ],
      "backend_tests": [
        "tests.test_independent_activity_read_http.IndependentReadHTTPTests.test_science_series_read_independent_of_unowned_and_hidden_follower",
